---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Footer } from "@features/landing/footer";
import { Header } from "@features/landing/header";
import CaseGalleryCarousel from "@features/projects/CaseGalleryCarousel.astro";
import Container from "@shared/ui/Container.astro";
import { siteConfig } from "@shared/config/site.config";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.published);
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const projects = (await getCollection("projects", ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);

const projectDetails = {
  klipp: {
    displayTitle: "Klipp Studio",
    headline: "Una experiencia digital para mostrar el trabajo del estudio.",
    category: "WEB · DISEÑO · DESARROLLO",
    year: "2026",
    role: "Diseño y desarrollo",
    deliverables: "Sitio web · UX · Frontend",
    intro: "Una presencia digital alrededor del trabajo visual.",
    result: "El sitio ordena los servicios y el portafolio en una navegación directa que mantiene el trabajo visual como protagonista.",
    heroImage: "/images/projects/project-klipp-devices.png",
    heroAlt: "Sitio web de Klipp Studio mostrado en una laptop y un teléfono móvil",
    transitionName: "project-klipp",
    nextSlug: "sms-fortuna",
  },
  "sms-fortuna": {
    displayTitle: "SMS Fortuna",
    headline: "Plataforma para gestionar operaciones de mensajería.",
    category: "SOFTWARE · WEB",
    year: "2026",
    role: "Diseño y desarrollo",
    deliverables: "Landing · Backoffice · Frontend",
    intro: "Control y mensajería desde un solo panel.",
    result: "La landing explica el servicio y sus vías de integración; el backoffice reúne usuarios, saldo y recargas para la gestión diaria.",
    heroImage: "/images/projects/project-sms-fortuna-devices.png",
    heroAlt: "Plataforma web de SMS Fortuna mostrada en una laptop y un teléfono móvil",
    transitionName: "project-sms-fortuna",
    nextSlug: "el-pueblo",
  },
  "el-pueblo": {
    displayTitle: "El Pueblo",
    headline: "Un panel operativo para controlar ventas, stock y compras.",
    category: "DASHBOARD · INVENTARIO · COMPRAS",
    year: "2026",
    role: "Diseño y desarrollo",
    deliverables: "Dashboard · Inventario · Frontend",
    intro: "Ventas, inventario y compras en un solo panel.",
    result: "Ventas, compras, inventario y actividad del día quedan reunidos en el panel operativo de la botica.",
    heroImage: "/images/projects/project-botica-devices.png",
    heroAlt: "Sistema de Botica El Pueblo mostrado en una laptop y un teléfono móvil",
    transitionName: "project-botica",
    nextSlug: "saul-guzman",
  },
  "saul-guzman": {
    displayTitle: "Saúl Guzmán",
    headline: "Una presencia digital para acercar la asesoría legal a personas y empresas.",
    category: "WEB · SERVICIOS LEGALES",
    year: "2026",
    role: "Diseño y desarrollo",
    deliverables: "Sitio web · Áreas de práctica · Contacto por WhatsApp",
    intro: "Un sitio profesional para presentar sus áreas de práctica.",
    result: "La presentación profesional, las áreas de práctica y el contacto por WhatsApp quedan accesibles desde computadora y móvil.",
    heroImage: "/images/projects/project-saul-guzman-devices.png",
    heroAlt: "Sitio web de Wilfredo Saúl Guzmán Vásquez en una laptop y un teléfono móvil",
    transitionName: "project-saul-guzman",
    nextSlug: "klipp",
  },
} as const;

const currentDetail = projectDetails[project.data.slug as keyof typeof projectDetails] ?? {
  displayTitle: project.data.title,
  headline: project.data.summary,
  category: project.data.scope.replaceAll(" - ", " · ").toUpperCase(),
  year: "2026",
  role: "Diseño y desarrollo",
  deliverables: project.data.scope.replaceAll(" - ", " · "),
  intro: project.data.summary,
  result: project.data.problem,
  heroImage: project.data.coverImage,
  heroAlt: project.data.coverImageAlt,
  transitionName: `project-${project.data.slug}`,
  nextSlug: projects[0]?.data.slug ?? project.data.slug,
};

const projectGalleries = {
  klipp: [
    {
      src: "/images/projects/project-klipp-principal.webp",
      alt: "Pantalla principal del proyecto Klipp Studio",
    },
    {
      src: "/images/projects/project-klipp-sesion.webp",
      alt: "Pantalla de inicio de sesión del proyecto Klipp Studio",
    },
    {
      src: "/images/projects/project-klipp-cumpleaños.webp",
      alt: "Vista de cumpleaños y beneficios del proyecto Klipp Studio",
    },
  ],
  "sms-fortuna": [
    {
      src: "/images/projects/project-sms-fortuna-landing.webp",
      alt: "Landing del proyecto SMS Fortuna",
    },
    {
      src: "/images/projects/project-sms-fortuna-backoffice.webp",
      alt: "Dashboard operativo del proyecto SMS Fortuna",
    },
    {
      src: "/images/projects/project-sms-fortuna-recargas.webp",
      alt: "Pantalla de recargas del proyecto SMS Fortuna",
    },
  ],
  "el-pueblo": [
    {
      src: "/images/projects/project-botica-dashboard.webp",
      alt: "Dashboard principal del proyecto Botica El Pueblo",
    },
    {
      src: "/images/projects/project-botica-compras.webp",
      alt: "Vista de compras del proyecto Botica El Pueblo",
    },
    {
      src: "/images/projects/project-botica-login.webp",
      alt: "Pantalla de acceso del sistema Botica El Pueblo",
    },
  ],
} as const;

const galleryImages =
  projectGalleries[project.data.slug as keyof typeof projectGalleries] ??
  project.data.galleryImages;

const nextProject = projects.find((entry) => entry.data.slug === currentDetail.nextSlug);
const nextDetail = nextProject && projectDetails[nextProject.data.slug as keyof typeof projectDetails];

---

<BaseLayout
  title={project.data.seoTitle}
  description={project.data.seoDescription}
  canonical={`${siteConfig.url}/casos-de-exito/${project.data.slug}/`}
>
  <Header />
  <main id="contenido-principal" class="bg-white">
    <section class="case-hero bg-kuroki-black text-white" data-case-project={project.data.slug}>
      <Container class="case-container max-w-[1680px]">
        <a class="case-back-link" href="/casos-de-exito/"><span aria-hidden="true">&larr;</span> Todos los casos</a>
        <div class="case-hero__intro">
          <h1>{currentDetail.displayTitle}</h1>
          <p>{currentDetail.headline}</p>
        </div>
        <div class="case-hero__meta" aria-label="Datos principales del caso">
          <span>{currentDetail.category}</span>
          <span>{currentDetail.year}</span>
        </div>
        <figure class="case-hero__media" transition:name={currentDetail.transitionName}>
          <img
            src={currentDetail.heroImage}
            alt={currentDetail.heroAlt}
            width="1400"
            height="1050"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      </Container>
    </section>

    <section class="case-overview bg-white text-kuroki-black">
      <Container class="case-container max-w-[1680px]">
        <div class="case-overview__layout">
          <div>
            <p class="case-eyebrow">EL CASO</p>
            <h2>{currentDetail.intro}</h2>
          </div>
          <div class="case-overview__copy">
            <div class="case-story" aria-label="Resumen del caso">
              <div class="case-story__item">
                <span>01 · EL RETO</span>
                <p>{project.data.problem}</p>
              </div>
              <div class="case-story__item">
                <span>02 · LA RESPUESTA</span>
                <p>{project.data.solution}</p>
              </div>
              <div class="case-story__item">
                <span>03 · EL APORTE</span>
                <p>{currentDetail.result}</p>
              </div>
            </div>
            {project.data.slug === "saul-guzman" && (
              <a class="case-project-link" href="https://saulguzman.com/" target="_blank" rel="noopener noreferrer">
                Visitar sitio web <span aria-hidden="true">&nearr;</span>
              </a>
            )}
            <dl class="case-facts">
              <div>
                <dt>ROL</dt>
                <dd>{currentDetail.role}</dd>
              </div>
              <div>
                <dt>ENTREGABLES</dt>
                <dd>{currentDetail.deliverables}</dd>
              </div>
              <div>
                <dt>AÑO</dt>
                <dd>{currentDetail.year}</dd>
              </div>
            </dl>
          </div>
        </div>
      </Container>
    </section>

    <CaseGalleryCarousel images={galleryImages} />
    {nextProject && (
      <section class="case-next bg-kuroki-black text-white">
        <Container>
          <a class="case-next__link" href={`/casos-de-exito/${nextProject.data.slug}/`}>
            <span class="case-next__eyebrow">SIGUIENTE PROYECTO</span>
            <span class="case-next__title">{nextDetail?.displayTitle ?? nextProject.data.title}</span>
            <span class="case-next__arrow" aria-hidden="true">&nearr;</span>
          </a>
          <a class="case-next__contact" href="/#contacto">Hablemos de tu proyecto <span aria-hidden="true">&nearr;</span></a>
        </Container>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
