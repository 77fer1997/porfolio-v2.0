---
import Container from "@shared/ui/Container.astro";

const trustItems = [
  { value: "3 rutas", label: "web, automatizacion o software" },
  { value: "1 diagnostico", label: "para ordenar alcance y prioridad" },
  { value: "Entrega por etapas", label: "avances visibles, menos riesgo" },
];
---

<section class="border-y border-white/10 bg-kuroki-black py-8">
  <Container>
    <div class="grid gap-6 sm:grid-cols-3" data-reveal-group>
      {
        trustItems.map((item) => (
          <div class="border-l border-white/12 pl-5" data-reveal>
            <p class="text-base font-extrabold text-white">{item.value}</p>
            <p class="mt-2 text-sm leading-6 text-text-secondary">{item.label}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
