---
import Container from "@shared/ui/Container.astro";

const companies = [
  { name: "SMS FORTUNA", href: "/proyectos/fortuna/" },
  { name: "BOTICA EL PUEBLO", href: "/proyectos/botica/" },
  { name: "KLIPP STUDIO", href: "/proyectos/klipp/" },
  { name: "PROXIMA MARCA", href: "#contacto" },
  { name: "CLIENTE 05", href: "#contacto" },
  { name: "CLIENTE 06", href: "#contacto" },
];
---

<section class="client-trust bg-white text-kuroki-black">
  <Container class="max-w-[1680px]">
    <div class="client-trust__layout" data-reveal-group>
      <div class="client-trust__list">
        {
          companies.map((company) => (
            <a
              href={company.href}
              class="client-trust__client"
              data-reveal
            >
              {company.name}
            </a>
          ))
        }
      </div>

      <a href="#proyectos" class="client-trust__link" data-reveal>
        Ver todos los clientes
        <span aria-hidden="true">&nearr;</span>
      </a>
    </div>
  </Container>
</section>
