---
import Container from "@shared/ui/Container.astro";

const companies = [
  {
    name: "Botica El Pueblo",
    href: "/proyectos/botica/",
    logo: "/images/projects/client-botica-el-pueblo.webp",
  },
  {
    name: "FCA",
    href: "#contacto",
    logo: "/images/projects/client-fca.webp",
  },
  {
    name: "SMS Fortuna",
    href: "/proyectos/fortuna/",
    logo: "/images/projects/client-fortuna.webp",
  },
  {
    name: "Klipp Studio",
    href: "/proyectos/klipp/",
    logo: "/images/projects/client-klipp.webp",
  },
];
---

<section class="client-trust bg-white text-kuroki-black">
  <Container class="max-w-[1680px]">
    <div class="client-trust__layout" data-reveal-group>
      <div class="client-trust__list">
        {
          companies.map((company) => (
            <a
              href={company.href}
              class="client-trust__client"
              data-reveal
            >
              <img src={company.logo} alt={company.name} loading="lazy" />
            </a>
          ))
        }
      </div>

      <a href="#proyectos" class="client-trust__link" data-reveal>
        Ver todos los clientes
        <span aria-hidden="true">&nearr;</span>
      </a>
    </div>
  </Container>
</section>
