---
import Container from "@shared/ui/Container.astro";

const companies = [
  {
    name: "Botica El Pueblo",
    href: "/casos-de-exito/el-pueblo/",
    logo: "/images/projects/client-botica-el-pueblo.webp",
  },
  {
    name: "FCA",
    href: "#contacto",
    logo: "/images/projects/client-fca.webp",
  },
  {
    name: "SMS Fortuna",
    href: "/casos-de-exito/sms-fortuna/",
    logo: "/images/projects/client-fortuna.webp",
  },
  {
    name: "Klipp Studio",
    href: "/casos-de-exito/klipp/",
    logo: "/images/projects/client-klipp.webp",
  },
];
---

<section class="client-trust bg-white text-kuroki-black">
  <Container class="max-w-[1680px]">
    <div class="client-trust__layout" data-reveal-group>
      <div class="client-trust__list">
        {
          companies.map((company) => (
            <a
              href={company.href}
              class="client-trust__client"
              data-reveal
            >
              <img src={company.logo} alt={company.name} loading="lazy" />
            </a>
          ))
        }
      </div>

    </div>
  </Container>
</section>

<style>
  .client-trust { padding-block: 36px; }
  .client-trust__list { max-width: 1100px; margin-inline: auto; gap: 32px; }
  .client-trust__client { min-height: 64px; }
  .client-trust__client img { max-height: 52px; max-width: min(190px, 100%); }
  @media (max-width: 767px) { .client-trust { padding-block: 28px; } .client-trust__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 32px; } .client-trust__client img { max-height: 44px; max-width: min(140px, 100%); } }
</style>
