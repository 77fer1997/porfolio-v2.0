---
import Container from "@shared/ui/Container.astro";

const services = [
  {
    id: "web",
    label: "LANDINGS",
    statement: "Convierte visitas en oportunidades.",
    description:
      "Diseñamos landing pages y sitios web claros, rápidos y enfocados en convertir.",
  },
  {
    id: "automatizacion",
    label: "AUTOMATIZACIÓN",
    statement: "Menos tareas repetitivas. Más tiempo para lo importante.",
    description:
      "Automatizamos procesos y conectamos herramientas para reducir trabajo manual.",
  },
  {
    id: "software",
    label: "SOFTWARE A MEDIDA",
    statement: "Cuando lo genérico ya no alcanza.",
    description:
      "Construimos sistemas adaptados a los procesos, reglas y necesidades de tu operación.",
  },
] as const;
---

<section id="servicios" class="services-editorial bg-kuroki-black text-white">
  <Container class="max-w-[1680px]">
    <div class="services-editorial__header" data-reveal>
      <p>SERVICIOS</p>
      <h2>Construimos lo que tu operacion realmente necesita.</h2>
    </div>

    <div class="services-editorial__list" data-reveal-group>
      {
        services.map((service) => (
          <a id={service.id} href={`#${service.id}`} class="service-row scroll-mt-24" data-reveal>
            <span class="service-row__label">{service.label}</span>
            <span class="service-row__main">
              <span class="service-row__statement">{service.statement}</span>
            </span>
            <span class="service-row__side">
              <span class="service-row__description">{service.description}</span>
              <span class="service-row__action">
                <span class="service-row__action-text">Ver servicio</span>
                <span aria-hidden="true">&nearr;</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>
