---
import Button from "@shared/ui/Button.astro";
import Container from "@shared/ui/Container.astro";
import SectionHeading from "@shared/ui/SectionHeading.astro";
import ServiceVisual from "./ServiceVisual.astro";
import { serviceLevels } from "./services.data";
---

<section id="servicios" class="bg-kuroki-black py-24 sm:py-32">
  <Container>
    <SectionHeading
      eyebrow="SERVICIOS"
      title="Soluciones segun la etapa de tu empresa"
      intro="No todas las empresas necesitan la misma tecnologia. Organizamos nuestros servicios en tres niveles para proponer una solucion adecuada al problema, la complejidad y la capacidad de inversion de cada negocio."
      dark
    />
    <div class="mt-14 space-y-8" data-reveal-group>
      {serviceLevels.map((service) => (
        <article class="grid gap-8 rounded-lg border border-white/10 bg-surface-elevated p-6 lg:grid-cols-[1fr_.9fr] lg:p-8" data-reveal>
          <div>
            <p class="text-sm font-extrabold tracking-[0.16em] text-kuroki-orange">{service.number}</p>
            <h3 class="mt-3 text-2xl font-extrabold text-white sm:text-3xl">{service.title}</h3>
            <p class="mt-2 font-semibold text-text-secondary">{service.subtitle}</p>
            <p class="mt-5 leading-8 text-text-secondary">{service.description}</p>
            <ul class="mt-6 grid gap-2 sm:grid-cols-2">
              {service.includes.map((item) => (
                <li class="flex gap-2 text-sm text-white/85"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-kuroki-orange"></span>{item}</li>
              ))}
            </ul>
            <p class="mt-6 border-l-2 border-kuroki-orange pl-4 text-sm leading-7 text-text-secondary">{service.result}</p>
            <Button href="#contacto" class="mt-6">{service.cta}</Button>
          </div>
          <ServiceVisual type={service.visual} />
        </article>
      ))}
    </div>
  </Container>
</section>
