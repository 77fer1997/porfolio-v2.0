---
import Button from "@shared/ui/Button.astro";
import Container from "@shared/ui/Container.astro";
import { serviceLevels } from "./services.data";
---

<section id="servicios" class="bg-kuroki-black py-24 sm:py-32">
  <Container>
    <div class="max-w-3xl" data-reveal>
      <p class="mb-4 text-sm font-bold tracking-[0.18em] text-kuroki-orange">SERVICIOS</p>
      <h2 class="max-w-[760px] text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-[2.65rem]">
        La solucion depende de donde esta el problema
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-8 text-text-secondary">
        Desde mejorar tu presencia digital hasta automatizar procesos o construir software propio. Empezamos por lo que realmente necesitas.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {
        serviceLevels.map((service) => {
          const serviceId =
            service.number === "01"
              ? "servicio-web"
              : service.number === "02"
                ? "servicio-automatizacion"
                : "servicio-software";

          return (
          <article id={serviceId} class="scroll-mt-24 flex h-full flex-col rounded-lg border border-white/10 bg-white/[0.035] p-7 sm:p-8" data-reveal>
            <div>
              <p class="text-sm font-extrabold text-kuroki-orange">{service.number}</p>
              <p class="mt-7 text-xs font-extrabold uppercase tracking-[0.18em] text-white/68">
                {service.name}
              </p>
              <h3 class="mt-4 text-2xl font-extrabold leading-tight text-white">
                {service.headline}
              </h3>
              <p class="mt-5 text-sm leading-7 text-text-secondary">
                {service.description}
              </p>
              <div class="mt-7 flex flex-wrap gap-2">
                {service.tags.map((tag) => (
                  <span class="rounded-sm border border-white/[0.12] bg-white/[0.015] px-2.5 py-1 text-xs font-semibold text-white/62">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-auto pt-8">
              <div class="border-t border-white/10 pt-6">
                <p class="text-sm leading-7 text-text-secondary">
                  <span class="font-extrabold text-white/90">Ideal si → </span>
                  {service.ideal}
                </p>
              </div>
            </div>
          </article>
          );
        })
      }
    </div>

    <div class="mx-auto mt-16 max-w-2xl text-center" data-reveal>
      <h3 class="text-2xl font-extrabold leading-tight text-white sm:text-3xl">
        ¿No sabes qué solución necesitas?
      </h3>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-text-secondary sm:text-base">
        Cuéntanos cómo funciona tu negocio y te ayudamos a identificar por dónde empezar.
      </p>
      <Button href="#contacto" class="mt-7">Cuéntanos tu proyecto</Button>
    </div>
  </Container>
</section>
