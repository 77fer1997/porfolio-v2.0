---
import Container from "@shared/ui/Container.astro";
import SectionHeading from "@shared/ui/SectionHeading.astro";
import { teamMembers } from "./team.data";
---

<section id="nosotros" class="bg-kuroki-black py-24 sm:py-32">
  <Container>
    <SectionHeading
      eyebrow="NOSOTROS"
      title="Un equipo enfocado en producto, tecnologia y operacion"
      intro="KUROKI reune estrategia digital, experiencia de usuario y desarrollo para acompanar proyectos desde la definicion hasta la evolucion."
      dark
    />
    <div class="mt-14 grid gap-5 md:grid-cols-3" data-reveal-group>
      {teamMembers.map((member) => (
        <article class="rounded-lg border border-white/10 bg-white/[0.03] p-5" data-reveal>
          <img src={member.avatar} alt={`Avatar provisional de ${member.name}`} width="320" height="240" loading="lazy" decoding="async" class="aspect-[4/3] w-full rounded-md object-cover" />
          <h3 class="mt-5 text-xl font-bold text-white">{member.name}</h3>
          <p class="mt-1 text-sm font-bold text-kuroki-orange">{member.role}</p>
          <p class="mt-3 text-sm leading-7 text-text-secondary">{member.bio}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
