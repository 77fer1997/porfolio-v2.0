---
import { siteConfig } from "@shared/config/site.config";
import { navigationItems } from "./navigation.data";

interface Props {
  tone?: "light" | "dark";
}

const { tone = "dark" } = Astro.props;
---

<header class="site-header fixed inset-x-0 top-0 z-40 bg-transparent" data-site-header data-tone={tone} data-hidden="false">
  <div class="site-header__bar mx-auto flex w-full max-w-[1720px] items-center justify-between gap-5 px-[clamp(24px,4vw,72px)]">
    <a href="/#inicio" class="header-logo flex items-center gap-3" aria-label="KUROKI inicio">
      <img src={siteConfig.logo} alt="KUROKI" width="163" height="32" class="header-logo__mark header-logo__mark--light h-7 w-auto sm:h-8" />
      <img src="/images/brand/logo-kuroki-dark.png" alt="" width="163" height="32" class="header-logo__mark header-logo__mark--dark h-7 w-auto sm:h-8" aria-hidden="true" />
    </a>
    <nav class="hidden items-center gap-9 lg:flex" aria-label="Navegacion principal">
      {navigationItems.map((item) => (
        <a class:list={["nav-link text-base font-medium transition", item.href.endsWith("#contacto") && "header-contact-link"]} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
    <button
      class="header-menu-button inline-flex min-h-12 min-w-12 items-center justify-center rounded-md border lg:hidden"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <span class="header-menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
  <nav id="mobile-menu" class="header-mobile-menu hidden border-t px-[clamp(24px,4vw,72px)] py-4 lg:hidden" aria-label="Navegacion movil" data-mobile-menu>
    <div class="mx-auto flex max-w-7xl flex-col gap-2">
      {navigationItems.map((item) => (
        <a class:list={["header-mobile-link py-4 text-base font-medium", item.href.endsWith("#contacto") && "header-mobile-contact"]} href={item.href}>
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const windowWithHeader = window as typeof window & {
    __kurokiHeaderCleanup?: () => void;
  };

  const initHeader = () => {
    windowWithHeader.__kurokiHeaderCleanup?.();

    const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    const header = document.querySelector<HTMLElement>("[data-site-header]");

    if (!header) {
      return;
    }

    let lastScrollY = Math.max(window.scrollY, 0);
    let ticking = false;

    const updateHeader = () => {
      const currentScrollY = Math.max(window.scrollY, 0);
      const isMenuOpen = button?.getAttribute("aria-expanded") === "true";
      const isScrollingDown = currentScrollY > lastScrollY + 4;
      const isScrollingUp = currentScrollY < lastScrollY - 4;

      header.setAttribute("data-scrolled", String(currentScrollY > 12));

      if (!isMenuOpen) {
        if (currentScrollY <= 24 || isScrollingUp) {
          header.setAttribute("data-hidden", "false");
        } else if (isScrollingDown) {
          header.setAttribute("data-hidden", "true");
        }
      }

      if (Math.abs(currentScrollY - lastScrollY) > 4) {
        lastScrollY = currentScrollY;
      }

      ticking = false;
    };

    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    };

    const handleMenuClick = () => {
      const expanded = button?.getAttribute("aria-expanded") === "true";
      button?.setAttribute("aria-expanded", String(!expanded));
      button?.setAttribute("aria-label", expanded ? "Abrir menu" : "Cerrar menu");
      header.setAttribute("data-hidden", "false");
      header.setAttribute("data-menu-open", String(!expanded));
      menu?.classList.toggle("hidden");
    };

    const menuLinks = Array.from(menu?.querySelectorAll<HTMLAnchorElement>("a") ?? []);
    const closeMenu = () => {
      header.setAttribute("data-menu-open", "false");
      button?.setAttribute("aria-expanded", "false");
      button?.setAttribute("aria-label", "Abrir menu");
      menu?.classList.add("hidden");
    };
    const handleEscape = (event: KeyboardEvent) => {
      if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
        closeMenu(); button.focus();
      }
    };
    const handleResize = () => { if (window.innerWidth >= 1024) closeMenu(); };
    const showOnFocus = () => header.setAttribute("data-hidden", "false");

    updateHeader();
    window.addEventListener("scroll", handleScroll, { passive: true });
    window.addEventListener("resize", handleResize);
    header.addEventListener("focusin", showOnFocus);
    document.addEventListener("keydown", handleEscape);
    button?.addEventListener("click", handleMenuClick);
    menuLinks.forEach((link) => link.addEventListener("click", closeMenu));

    windowWithHeader.__kurokiHeaderCleanup = () => {
      window.removeEventListener("scroll", handleScroll);
      window.removeEventListener("resize", handleResize);
      header.removeEventListener("focusin", showOnFocus);
      document.removeEventListener("keydown", handleEscape);
      button?.removeEventListener("click", handleMenuClick);
      menuLinks.forEach((link) => link.removeEventListener("click", closeMenu));
    };
  };

  document.addEventListener("astro:page-load", initHeader);
</script>

<style>
  .header-contact-link { border: 1px solid currentColor; border-radius: 4px; padding: 10px 18px; }
  .header-mobile-contact { color: #ff8650; }
  .header-menu-icon { position: relative; display: block; width: 24px; height: 20px; }
  .header-menu-icon > span { position: absolute; left: 0; width: 24px; height: 2px; background: currentColor; transition: transform 250ms ease, opacity 180ms ease; }
  .header-menu-icon > span:nth-child(1) { top: 2px; }
  .header-menu-icon > span:nth-child(2) { top: 9px; }
  .header-menu-icon > span:nth-child(3) { top: 16px; }
  .header-menu-button[aria-expanded="true"] .header-menu-icon > span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .header-menu-button[aria-expanded="true"] .header-menu-icon > span:nth-child(2) { opacity: 0; }
  .header-menu-button[aria-expanded="true"] .header-menu-icon > span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .nav-link:focus-visible, .header-menu-button:focus-visible, .header-mobile-link:focus-visible { outline: 2px solid #ff8650; outline-offset: 5px; }
  @media (prefers-reduced-motion: reduce) { .header-menu-icon > span { transition: none; } }
</style>
