---
import { siteConfig } from "@shared/config/site.config";
import { navigationItems } from "./navigation.data";

interface Props {
  tone?: "light" | "dark";
}

const { tone = "dark" } = Astro.props;
---

<header class="site-header absolute inset-x-0 top-0 z-40 bg-transparent" data-site-header data-tone={tone}>
  <div class="mx-auto flex h-24 w-full max-w-[1720px] items-center justify-between gap-5 px-[clamp(24px,4vw,72px)]">
    <a href="/#inicio" class="header-logo flex items-center gap-3" aria-label="KUROKI inicio">
      {
        tone === "light" ? (
          <img src="/images/brand/logo-kuroki-dark.png" alt="KUROKI" width="163" height="32" class="h-7 w-auto sm:h-8" />
        ) : (
          <img src={siteConfig.logo} alt="KUROKI" width="163" height="32" class="h-7 w-auto sm:h-8" />
        )
      }
    </a>
    <nav class="hidden items-center gap-9 lg:flex" aria-label="Navegacion principal">
      {navigationItems.map((item) => (
        <a class:list={["nav-link text-lg font-semibold transition", item.external && "nav-link--accent"]} href={item.href}>
          {item.label}
          {item.external && <span aria-hidden="true">&nearr;</span>}
        </a>
      ))}
    </nav>
    <button
      class="header-menu-button inline-flex min-h-12 min-w-12 items-center justify-center rounded-md border lg:hidden"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <span class="h-0.5 w-6 bg-current before:block before:h-0.5 before:w-6 before:-translate-y-2 before:bg-current before:content-[''] after:block after:h-0.5 after:w-6 after:translate-y-1.5 after:bg-current after:content-['']"></span>
    </button>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-kuroki-black/10 bg-white px-5 py-5 lg:hidden" aria-label="Navegacion movil" data-mobile-menu>
    <div class="mx-auto flex max-w-7xl flex-col gap-2">
      {navigationItems.map((item) => (
        <a class="rounded-md px-3 py-3 text-base font-semibold text-kuroki-black hover:bg-kuroki-black/5" href={item.href}>
          {item.label}
          {item.external && <span class="text-kuroki-orange" aria-hidden="true"> &nearr;</span>}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-mobile-menu]");
  const header = document.querySelector("[data-site-header]");

  const updateHeader = () => {
    header?.setAttribute("data-scrolled", String(window.scrollY > 12));
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  button?.addEventListener("click", () => {
    const expanded = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      button?.setAttribute("aria-expanded", "false");
      menu.classList.add("hidden");
    });
  });
</script>
