---
import Button from "@shared/ui/Button.astro";
import Container from "@shared/ui/Container.astro";
import SectionHeading from "@shared/ui/SectionHeading.astro";
import { featuredProjects } from "./projects.data";

const projects = featuredProjects.filter((project) => project.published && project.featured);
---

<section id="proyectos" class="bg-surface-light py-24 text-kuroki-black sm:py-32">
  <Container>
    <SectionHeading
      eyebrow="PROYECTOS"
      title="Soluciones que hemos construido"
      intro="Cada proyecto comienza con un problema concreto. Disenamos la solucion, construimos la tecnologia necesaria y acompanamos su implementacion."
    />
    <div class="mt-14 space-y-10" data-reveal-group>
      {projects.map((project) => (
        <article class="grid gap-8 border-t border-border-light pt-10 lg:grid-cols-[.85fr_1.15fr] lg:items-center" data-reveal>
          <div>
            <p class="text-sm font-extrabold tracking-[0.16em] text-kuroki-orange">{project.number} / {project.category}</p>
            <h3 class="mt-4 text-3xl font-extrabold">{project.name}</h3>
            <p class="mt-4 leading-8 text-kuroki-gray">{project.description}</p>
            <dl class="mt-6 grid gap-4">
              <div><dt class="font-bold">Problema</dt><dd class="mt-1 text-sm leading-7 text-kuroki-gray">{project.problem}</dd></div>
              <div><dt class="font-bold">Solucion</dt><dd class="mt-1 text-sm leading-7 text-kuroki-gray">{project.solution}</dd></div>
              <div><dt class="font-bold">Alcance</dt><dd class="mt-1 text-sm leading-7 text-kuroki-gray">{project.scope}</dd></div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-2">
              {project.technologies.map((tech) => <span class="rounded border border-border-light px-3 py-1 text-xs font-bold">{tech}</span>)}
            </div>
            <Button href={`/proyectos/${project.slug}/`} variant="dark" class="mt-7">Ver caso completo</Button>
          </div>
          <figure class="overflow-hidden rounded-lg border border-border-light bg-white">
            <img src={project.image} alt={project.imageAlt} width="880" height="560" loading="lazy" decoding="async" class="h-auto w-full" />
          </figure>
        </article>
      ))}
    </div>
  </Container>
</section>
