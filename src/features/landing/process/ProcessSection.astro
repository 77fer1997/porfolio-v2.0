---
import { processSteps } from "./process.data";
---
<section id="metodo" class="work-method" aria-labelledby="method-title">
  <div class="method-wrap">
    <header class="method-heading">
      <div><p class="method-label">CÓMO TRABAJAMOS</p><h2 id="method-title">Del diagnóstico a la mejora continua.</h2></div>
      <p>Trabajamos contigo en cada decisión, con avances claros desde el inicio.</p>
    </header>
    <ol class="method-track">
      {processSteps.map((step) => (
        <li>
          <span class="method-number" aria-hidden="true">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
          <span class="method-outcome">{step.outcome}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .work-method { background: #151515; color: #f5f5f5; padding-block: clamp(88px, 8vw, 120px); scroll-margin-top: 80px; }
  .method-wrap { width: calc(100% - clamp(48px, 8vw, 144px)); max-width: 1576px; margin-inline: auto; }
  .method-heading { display: flex; justify-content: space-between; align-items: end; gap: 48px; margin-bottom: clamp(56px, 6vw, 80px); }
  .method-label { margin: 0 0 24px; color: #3dbddf; font-size: 12px; font-weight: 500; }
  .method-heading h2 { max-width: 760px; margin: 0; font-size: clamp(44px, 5vw, 64px); font-weight: 500; line-height: 1.08; letter-spacing: -.025em; }
  .method-heading > p { max-width: 380px; color: #b8b8b8; font-size: 16px; line-height: 1.7; margin: 0 0 4px; }
  .method-track { position: relative; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; padding: 0; margin: 0; }
  .method-track::before { content: ''; position: absolute; top: 7px; right: 0; left: 0; height: 1px; background: #ffffff38; }
  .method-track li { position: relative; min-width: 0; padding: 36px 28px 0 0; }
  .method-track li + li { padding-left: 28px; }
  .method-track li::before { content: ''; position: absolute; z-index: 1; top: 0; left: 0; width: 15px; height: 15px; border: 4px solid #151515; border-radius: 50%; background: #3dbddf; box-shadow: 0 0 0 1px #3dbddf; }
  .method-track li + li::before { left: 28px; }
  .method-number { display: inline-block; margin-bottom: 12px; color: #3dbddf; font-size: 15px; font-weight: 500; letter-spacing: .08em; font-variant-numeric: tabular-nums; }
  .method-track h3 { min-height: 2.5em; margin: 0 0 14px; max-width: 260px; font-size: clamp(21px, 2vw, 25px); font-weight: 500; line-height: 1.25; }
  .method-track p { min-height: 5.1em; color: #c4c4c4; margin: 0; font-size: 15px; line-height: 1.7; }
  .method-outcome { display: block; margin-top: 22px; border-top: 1px solid #ffffff26; padding-top: 14px; color: #aeb8c2; font-size: 12px; line-height: 1.6; }
  @media (max-width: 1023px) { .method-heading h2 { font-size: 44px; } .method-track { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 44px 28px; } .method-track::before { display: none; } .method-track li, .method-track li + li { border-top: 1px solid #ffffff36; padding: 30px 0 0; } .method-track li::before, .method-track li + li::before { top: -8px; left: 0; } .method-track p { min-height: 0; } }
  @media (max-width: 767px) { .work-method { padding-block: 64px; } .method-heading { display: block; margin-bottom: 52px; } .method-heading h2 { font-size: 36px; } .method-heading > p { margin-top: 20px; } }
  @media (max-width: 479px) { .method-track { grid-template-columns: 1fr; gap: 30px; } .method-track li, .method-track li + li { padding-top: 26px; } .method-track h3 { font-size: 23px; max-width: none; } .method-outcome { margin-top: 16px; } }
</style>
