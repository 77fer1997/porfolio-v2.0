---
import { processSteps } from "./process.data";
---
<section id="metodo" class="work-method" aria-labelledby="method-title">
  <div class="method-wrap">
    <header class="method-heading">
      <div><p class="method-label">CÓMO TRABAJAMOS</p><h2 id="method-title">Cada paso, con un propósito.</h2></div>
      <p>Primero entendemos tu negocio.<br />Después elegimos cómo construir.</p>
    </header>
    <ol class="method-track">
      {processSteps.map((step) => (
        <li>
          <span class="method-number" aria-hidden="true">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
          <span class="method-outcome">{step.outcome}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .work-method { background: #151515; color: #f5f5f5; padding-block: 88px; scroll-margin-top: 80px; }
  .method-wrap { width: calc(100% - 96px); max-width: 1360px; margin-inline: auto; }
  .method-heading { display: flex; justify-content: space-between; align-items: end; gap: 40px; margin-bottom: 56px; }
  .method-label { margin: 0 0 24px; color: #ff9462; font-size: 12px; font-weight: 500; }
  .method-heading h2 { max-width: 600px; margin: 0; font-size: 44px; font-weight: 500; line-height: 1.2; }
  .method-heading > p { color: #aaa; font-size: 16px; line-height: 1.7; margin: 0; }
  .method-track { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 0; margin: 0; }
  .method-track li { position: relative; border-top: 1px solid #ffffff36; padding: 28px 28px 0 0; min-width: 0; }
  .method-track li + li { padding-left: 28px; }
  .method-track li::before { content: ''; position: absolute; left: 0; top: -3px; width: 5px; height: 5px; background: #ee7c49; }
  .method-track li + li::before { left: 28px; }
  .method-number { color: #ff9462; font-size: 13px; font-variant-numeric: tabular-nums; }
  .method-track h3 { margin: 28px 0 16px; max-width: 250px; font-size: 23px; font-weight: 500; line-height: 1.3; min-height: 2.6em; }
  .method-track p { color: #bcbcbc; margin: 0; font-size: 15px; line-height: 1.7; }
  .method-outcome { display: block; margin-top: 26px; color: #a4a4a4; font-size: 12px; line-height: 1.7; }
  @media (max-width: 1023px) { .method-wrap { width: calc(100% - 64px); } .method-heading h2 { font-size: 36px; } .method-track { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px; } .method-track li, .method-track li + li { padding: 24px 0 0; } .method-track li + li::before { left: 0; } .method-track h3 { min-height: 0; } }
  @media (max-width: 767px) { .work-method { padding-block: 64px; } .method-wrap { width: calc(100% - 40px); } .method-heading { display: block; margin-bottom: 36px; } .method-heading h2 { font-size: 32px; } .method-heading > p { margin-top: 22px; } }
  @media (max-width: 479px) { .method-track { grid-template-columns: 1fr; gap: 28px; } .method-track h3 { margin-top: 16px; font-size: 23px; max-width: none; } .method-outcome { margin-top: 16px; } }
</style>
