---
import Container from "@shared/ui/Container.astro";
import { processSteps } from "./process.data";
---

<section id="metodo" class="method-section bg-white text-kuroki-black">
  <Container class="max-w-[1680px]">
    <div class="method-layout">
      <div class="method-intro" data-reveal>
        <p>MÉTODO</p>
        <h2>
          Primero entendemos.
          <span>Después construimos.</span>
        </h2>
        <small>No empezamos por la tecnología.</small>
      </div>

      <div class="method-steps" data-method-steps data-reveal-group>
        {
          processSteps.map((step, index) => (
            <button
              type="button"
              class:list={["method-step", index === 0 && "is-active"]}
              data-method-step
              data-reveal
              aria-expanded={index === 0 ? "true" : "false"}
            >
              <span class="method-step__number">{step.number}</span>
              <span class="method-step__body">
                <span class="method-step__title" role="heading" aria-level="3">{step.title}</span>
                <span class="method-step__content">
                  <span class="method-step__content-inner">
                    <span class="method-step__description">{step.description}</span>
                    <span class="method-step__outcome">{step.outcome}</span>
                  </span>
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<script>
  const initMethodSteps = () => {
    const groups = document.querySelectorAll<HTMLElement>("[data-method-steps]");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

    groups.forEach((group) => {
      const steps = Array.from(group.querySelectorAll<HTMLButtonElement>("[data-method-step]"));
      if (!steps.length) {
        return;
      }

      const setActive = (activeStep: HTMLButtonElement) => {
        steps.forEach((step) => {
          const isActive = step === activeStep;
          step.classList.toggle("is-active", isActive);
          step.setAttribute("aria-expanded", String(isActive));
        });
      };

      steps.forEach((step) => {
        step.addEventListener("click", () => setActive(step));
        step.addEventListener("focus", () => setActive(step));
        step.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            setActive(step);
          }
        });

        step.addEventListener("pointerenter", () => {
          if (finePointer.matches) {
            setActive(step);
          }
        });
      });
    });
  };

  initMethodSteps();
</script>
