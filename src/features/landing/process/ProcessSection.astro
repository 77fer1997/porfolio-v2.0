---
import Container from "@shared/ui/Container.astro";
import { processSteps } from "./process.data";
---

<section id="metodo" class="bg-kuroki-black py-24 sm:py-32">
  <Container>
    <div class="grid gap-14 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
      <div class="max-w-xl lg:sticky lg:top-28" data-reveal>
        <p class="mb-4 text-sm font-bold tracking-[0.18em] text-kuroki-orange">MÉTODO</p>
        <h2 class="max-w-[560px] text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-[2.65rem]">
          Primero entendemos. Después construimos.
        </h2>
        <p class="mt-5 max-w-lg text-base leading-8 text-text-secondary">
          No empezamos por la tecnología. Identificamos qué está frenando tu negocio, definimos lo necesario y avanzamos con entregas visibles.
        </p>
        <p class="mt-8 inline-flex border-l-2 border-kuroki-orange pl-4 text-sm font-extrabold text-white">
          No empezamos programando.
        </p>
      </div>

      <div class="relative" data-reveal-group>
        <div class="absolute bottom-10 left-[11px] top-3 w-px bg-white/10" aria-hidden="true"></div>
        <div class="grid gap-12">
          {
            processSteps.map((step) => (
              <article class="relative grid gap-5 pl-10" data-reveal>
                <span class="absolute left-0 top-2 h-6 w-6 rounded-full border border-kuroki-orange/70 bg-kuroki-black">
                  <span class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-kuroki-orange"></span>
                </span>
                <div class="border-b border-white/10 pb-10">
                  <p class="text-sm font-extrabold text-kuroki-orange">{step.number}</p>
                  <h3 class="mt-3 text-xl font-extrabold tracking-[0.08em] text-white sm:text-2xl">
                    {step.title}
                  </h3>
                  <p class="mt-4 max-w-2xl text-sm leading-7 text-text-secondary sm:text-base">
                    {step.description}
                  </p>
                  <p class="mt-5 text-sm leading-7 text-text-secondary">
                    <span class="font-extrabold text-white">Sales con → </span>
                    {step.outcome}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>
