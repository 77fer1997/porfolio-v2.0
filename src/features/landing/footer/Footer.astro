---
import { contactConfig } from "@shared/config/contact.config";
---
<footer class="studio-footer">
  <div class="footer-wrap">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-logo" href="/#inicio" aria-label="KUROKI inicio"><img src="/images/brand/logo-kuroki-dark.png" alt="KUROKI" width="163" height="32" loading="lazy" /></a>
        <p>Diseño, desarrollo y buenas ideas.<br /><span>Desde Arequipa, Perú.</span></p>
      </div>
      <nav aria-label="Navegación del pie de página"><a href="/casos-de-exito/">Casos de éxito</a><a href="/#servicios">Servicios</a><a href="/#metodo">Método</a><a href="/#contacto">Contacto</a></nav>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} KUROKI</span>
      <a href={"mailto:" + contactConfig.email}>{contactConfig.email}</a>
      <a href="/#inicio">Volver arriba <span aria-hidden="true">&uarr;</span></a>
    </div>
  </div>
</footer>
<style>
  .studio-footer { background: #3dbddf; color: #07111f; border-top: 1px solid rgba(7, 17, 31, 0.18); padding-block: 48px 24px; }
  .footer-wrap { width: calc(100% - 96px); max-width: 1360px; margin-inline: auto; }
  .footer-main { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 40px; padding-bottom: 36px; }
  .footer-brand { display: grid; gap: 14px; }
  .footer-logo { display: block; width: fit-content; }
  .footer-logo img { width: 156px; height: auto; }
  .footer-brand p { margin: 0; color: rgba(7, 17, 31, 0.82); font-size: 13px; line-height: 1.7; }
  .footer-brand p span { color: rgba(7, 17, 31, 0.62); }
  .footer-main nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px 30px; font-size: 13px; line-height: 1.5; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid rgba(7, 17, 31, 0.2); padding-top: 20px; color: rgba(7, 17, 31, 0.72); font-size: 12px; line-height: 1.5; }
  a { color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  a:hover { color: #06101e; text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid #07111f; outline-offset: 6px; }
  .footer-bottom a:last-child span { margin-left: 8px; color: #07111f; }
  @media (max-width: 1023px) { .footer-wrap { width: calc(100% - 64px); } .footer-main { gap: 32px; } .footer-main nav { gap: 14px 20px; } }
  @media (max-width: 767px) { .studio-footer { padding-block: 36px 20px; } .footer-wrap { width: calc(100% - 40px); } .footer-main { grid-template-columns: 1fr; gap: 28px; padding-bottom: 28px; } .footer-main nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); justify-content: start; gap: 14px 18px; } .footer-bottom { display: grid; grid-template-columns: 1fr auto; gap: 14px 18px; } .footer-bottom > span { grid-column: 1 / -1; } }
</style>
