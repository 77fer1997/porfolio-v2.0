---
import { siteConfig } from "@shared/config/site.config";
import { contactConfig } from "@shared/config/contact.config";
---
<footer class="studio-footer">
  <div class="footer-wrap">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-logo" href="/#inicio" aria-label="KUROKI inicio"><img src={siteConfig.logo} alt="KUROKI" width="200" height="40" loading="lazy" /></a>
        <p>Diseño, desarrollo y buenas ideas.<br /><span>Desde Arequipa, Perú.</span></p>
      </div>
      <nav aria-label="Navegación del pie de página"><a href="/casos-de-exito/">Casos de éxito</a><a href="/#servicios">Servicios</a><a href="/#metodo">Método</a><a href="/#contacto">Contacto</a></nav>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} KUROKI</span>
      <a href={"mailto:" + contactConfig.email}>{contactConfig.email}</a>
      <a href="/#inicio">Volver arriba <span aria-hidden="true">&uarr;</span></a>
    </div>
  </div>
</footer>
<style>
  .studio-footer { background: #0d0d0d; color: #b7c2d0; border-top: 1px solid rgba(255, 255, 255, 0.14); padding-block: 48px 24px; }
  .footer-wrap { width: calc(100% - clamp(48px, 8vw, 144px)); max-width: 1576px; margin-inline: auto; }
  .footer-main { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 40px; padding-bottom: 36px; }
  .footer-brand { display: grid; gap: 14px; }
  .footer-logo { display: block; width: fit-content; }
  .footer-logo img { width: 156px; height: auto; filter: hue-rotate(174deg) saturate(0.78) brightness(1.08); }
  .footer-brand p { margin: 0; color: #aeb9c6; font-size: 13px; line-height: 1.7; }
  .footer-brand p span { color: #78879a; }
  .footer-main nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px 30px; font-size: 13px; line-height: 1.5; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid rgba(174, 185, 198, 0.16); padding-top: 20px; color: #8290a1; font-size: 12px; line-height: 1.5; }
  a { color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  a:hover { color: #3dbddf; }
  a:focus-visible { outline: 2px solid #3dbddf; outline-offset: 6px; }
  .footer-bottom a:last-child span { margin-left: 8px; color: #3dbddf; }
  @media (max-width: 1023px) { .footer-main { gap: 32px; } .footer-main nav { gap: 14px 20px; } }
  @media (max-width: 767px) { .studio-footer { padding-block: 36px 20px; } .footer-main { grid-template-columns: 1fr; gap: 28px; padding-bottom: 28px; } .footer-main nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); justify-content: start; gap: 14px 18px; } .footer-bottom { display: grid; grid-template-columns: 1fr auto; gap: 14px 18px; } .footer-bottom > span { grid-column: 1 / -1; } }
</style>
