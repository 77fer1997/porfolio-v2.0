---
import { siteConfig } from "@shared/config/site.config";
import { contactConfig } from "@shared/config/contact.config";
---
<footer class="studio-footer">
  <div class="footer-wrap">
    <div class="footer-main">
      <a class="footer-logo" href="/#inicio" aria-label="KUROKI inicio"><img src={siteConfig.logo} alt="KUROKI" width="200" height="40" loading="lazy" /></a>
      <nav aria-label="Navegación del pie de página"><a href="/casos-de-exito/">Casos de éxito</a><a href="/#servicios">Servicios</a><a href="/#metodo">Método</a><a href="/#contacto">Contacto</a></nav>
      <p>Diseño, desarrollo y buenas ideas.<br /><span>Desde Arequipa, Perú.</span></p>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} KUROKI</span>
      <a href={"mailto:" + contactConfig.email}>{contactConfig.email}</a>
      <a href="/#inicio">Volver arriba <span aria-hidden="true">&uarr;</span></a>
    </div>
  </div>
</footer>
<style>
  .studio-footer { background: #0d0d0d; color: #bcbcbc; border-top: 1px solid #ffffff20; padding-block: 40px 28px; }
  .footer-wrap { width: calc(100% - 96px); max-width: 1360px; margin-inline: auto; }
  .footer-main { display: grid; grid-template-columns: .8fr 1.2fr 1fr; align-items: start; gap: 40px; padding-bottom: 40px; }
  .footer-logo { display: block; width: fit-content; }
  .footer-logo img { width: 180px; height: auto; }
  nav { display: grid; grid-template-columns: repeat(2, max-content); gap: 16px 32px; font-size: 14px; line-height: 1.5; }
  .footer-main p { margin: 0; font-size: 14px; line-height: 1.7; }
  .footer-main p span { color: #8f8f8f; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid #ffffff20; padding-top: 24px; color: #999; font-size: 12px; line-height: 1.5; }
  a { color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  a:hover { color: #3dbddf; }
  a:focus-visible { outline: 2px solid #3dbddf; outline-offset: 6px; }
  .footer-bottom a:last-child span { margin-left: 12px; color: #3dbddf; }
  @media (max-width: 1023px) { .footer-wrap { width: calc(100% - 64px); } .footer-main { grid-template-columns: 1fr 1fr; } .footer-main p { grid-column: 1 / -1; } }
  @media (max-width: 767px) { .footer-wrap { width: calc(100% - 40px); } .footer-main { grid-template-columns: 1fr; gap: 30px; } .footer-main p { grid-column: auto; } .footer-bottom { flex-wrap: wrap; gap: 16px 24px; } .footer-bottom > span { width: 100%; } }
</style>
