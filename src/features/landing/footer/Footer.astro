---
import Container from "@shared/ui/Container.astro";
import { siteConfig } from "@shared/config/site.config";
import { footerLinks } from "./footer.data";
---

<footer class="border-t border-white/10 bg-kuroki-black py-10">
  <Container class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <a href="/#inicio" class="flex items-center gap-3" aria-label="KUROKI inicio">
      <img src={siteConfig.logo} alt="KUROKI" width="123" height="24" class="h-6 w-auto" />
    </a>
    <nav class="flex flex-wrap gap-4" aria-label="Navegacion secundaria">
      {footerLinks.map((link) => <a class="text-sm font-semibold text-text-secondary hover:text-kuroki-orange" href={link.href}>{link.label}</a>)}
    </nav>
    <p class="text-sm text-text-secondary">&copy; {new Date().getFullYear()} KUROKI.</p>
  </Container>
</footer>
