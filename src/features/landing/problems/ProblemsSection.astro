---
import Container from "@shared/ui/Container.astro";

const problems = [
  {
    number: "01",
    title: "Tu web no convierte",
    description: "No comunica, no genera confianza o no facilita contacto.",
    category: "WEB",
    href: "#servicio-web",
  },
  {
    number: "02",
    title: "Tu operacion depende de tareas manuales",
    description: "La informacion se repite entre herramientas desconectadas.",
    category: "AUTOMATIZACION",
    href: "#servicio-automatizacion",
  },
  {
    number: "03",
    title: "Lo generico ya no alcanza",
    description: "Tu operacion necesita reglas, control y trazabilidad real.",
    category: "SOFTWARE",
    href: "#servicio-software",
  },
] as const;
---

<section id="problemas" class="problems-section bg-white text-kuroki-black">
  <Container class="max-w-[1680px]">
    <div class="max-w-[780px]" data-reveal>
      <p class="mb-4 text-sm font-bold tracking-[0.18em] text-kuroki-orange">
        PROBLEMAS
      </p>
      <h2
        class="max-w-[750px] text-3xl font-extrabold leading-tight text-kuroki-black sm:text-4xl lg:text-[2.65rem]"
      >
        No todos los problemas necesitan un sistema completo
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-8 text-kuroki-gray">
        Empezamos por el problema real.
      </p>
    </div>

    <div class="problems-list mt-14 lg:mt-20" data-reveal-group>
      {
        problems.map((problem) => (
          <a class="problem-link-row" href={problem.href} data-reveal>
            <span class="problem-link-number">{problem.number}</span>
            <span class="problem-link-content">
              <span class="problem-link-title">{problem.title}</span>
              <span class="problem-link-description">{problem.description}</span>
            </span>
            <span class="problem-link-side">
              <span class="problem-link-category">{problem.category}</span>
              <span class="problem-link-arrow" aria-hidden="true">&nearr;</span>
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>
