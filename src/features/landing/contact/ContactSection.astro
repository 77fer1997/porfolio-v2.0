---
import Container from "@shared/ui/Container.astro";
import SectionHeading from "@shared/ui/SectionHeading.astro";
import { contactConfig } from "@shared/config/contact.config";

const nextSteps = [
  {
    number: "01",
    title: "Entendemos tu situación",
    description: "Revisamos qué necesitas resolver.",
  },
  {
    number: "02",
    title: "Definimos por dónde empezar",
    description: "Identificamos la alternativa más adecuada.",
  },
  {
    number: "03",
    title: "Te proponemos el siguiente paso",
    description: "Recibes una recomendación inicial y un alcance claro.",
  },
];
---

<section id="contacto" class="relative overflow-hidden bg-kuroki-black py-20 sm:py-28">
  <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.035)_1px,transparent_1px)] bg-[size:44px_44px] opacity-70"></div>
  <Container class="relative grid items-start gap-10 lg:grid-cols-[.9fr_1.1fr]">
    <div data-reveal>
      <SectionHeading
        eyebrow="CONTACTO"
        title="Cuéntanos qué quieres resolver"
        intro="Explícanos qué está frenando tu negocio. Revisamos el contexto y te proponemos el siguiente paso más adecuado."
        dark
      />

      <div class="mt-7">
        {
          nextSteps.map((step) => (
            <div class="border-b border-white/[0.08] py-5 first:pt-0 last:border-b-0 last:pb-0">
              <span class="text-sm font-extrabold text-kuroki-orange">{step.number}</span>
              <p class="mt-3 font-extrabold text-white">{step.title}</p>
              <p class="mt-1.5 text-sm leading-6 text-text-secondary">{step.description}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-7">
        <p class="text-sm font-extrabold text-white">O escríbenos directamente</p>
        <address class="mt-4 grid gap-y-3 not-italic text-sm">
          <p class="grid gap-x-4 gap-y-1 sm:grid-cols-[92px_1fr]">
            <span class="font-bold text-text-secondary">Correo</span>
            <a class="font-semibold text-white hover:text-kuroki-orange" href={`mailto:${contactConfig.email}`}>{contactConfig.email}</a>
          </p>
          <p class="grid gap-x-4 gap-y-1 sm:grid-cols-[92px_1fr]">
            <span class="font-bold text-text-secondary">WhatsApp</span>
            <a class="font-semibold text-white hover:text-kuroki-orange" href={contactConfig.whatsappHref}>{contactConfig.whatsappLabel}</a>
          </p>
          <p class="grid gap-x-4 gap-y-1 sm:grid-cols-[92px_1fr]">
            <span class="font-bold text-text-secondary">LinkedIn</span>
            <a class="font-semibold text-white hover:text-kuroki-orange" href={contactConfig.linkedin}>Ver perfil</a>
          </p>
        </address>
      </div>
    </div>

    <form class="h-fit self-start rounded-lg border border-white/10 bg-white/[0.04] p-5 sm:p-6" action={contactConfig.formEndpoint} method="post" data-reveal>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-2 text-sm font-semibold text-white">
          Nombre
          <input required name="name" autocomplete="name" class="min-h-12 rounded-md border border-white/15 bg-kuroki-black px-4 text-white transition focus:border-kuroki-orange/70" />
        </label>
        <label class="grid gap-2 text-sm font-semibold text-white">
          Correo
          <input required type="email" name="email" autocomplete="email" class="min-h-12 rounded-md border border-white/15 bg-kuroki-black px-4 text-white transition focus:border-kuroki-orange/70" />
        </label>
      </div>
      <label class="mt-5 grid gap-2 text-sm font-semibold text-white">
        ¿Qué quieres mejorar?
        <select name="projectType" class="min-h-12 rounded-md border border-white/15 bg-kuroki-black px-4 text-white transition focus:border-kuroki-orange/70">
          <option>No estoy seguro</option>
          <option>Presencia digital</option>
          <option>Automatización</option>
          <option>Software a medida</option>
          <option>Otro</option>
        </select>
      </label>
      <label class="mt-5 grid gap-2 text-sm font-semibold text-white">
        Cuéntanos un poco más
        <textarea required name="message" rows="4" class="rounded-md border border-white/15 bg-kuroki-black px-4 py-3 text-white placeholder:text-white/35 transition focus:border-kuroki-orange/70" placeholder="Ej: recibimos leads por WhatsApp y queremos ordenar el seguimiento en un solo lugar."></textarea>
      </label>
      <button class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-md border border-kuroki-orange bg-kuroki-orange px-5 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-kuroki-black" type="submit">
        Cuéntanos tu proyecto
      </button>
    </form>
  </Container>
</section>
