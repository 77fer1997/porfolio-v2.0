---
import Container from "@shared/ui/Container.astro";
import SectionHeading from "@shared/ui/SectionHeading.astro";
import { contactConfig } from "@shared/config/contact.config";
---

<section id="contacto" class="relative overflow-hidden bg-kuroki-black py-24 sm:py-32">
  <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.035)_1px,transparent_1px)] bg-[size:44px_44px] opacity-70"></div>
  <Container class="relative grid gap-12 lg:grid-cols-[.9fr_1.1fr]">
    <div data-reveal>
      <SectionHeading
        eyebrow="CONTACTO"
        title="Cuentanos tu proyecto"
        intro="Describe tu necesidad, el estado actual y lo que te gustaria mejorar. Te responderemos con los siguientes pasos para evaluar alcance y prioridad."
        dark
      />
      <address class="mt-8 space-y-3 not-italic text-text-secondary">
        <p><a class="font-semibold text-white hover:text-kuroki-orange" href={`mailto:${contactConfig.email}`}>{contactConfig.email}</a></p>
        <p><a class="font-semibold text-white hover:text-kuroki-orange" href={contactConfig.whatsappHref}>{contactConfig.whatsappLabel}</a></p>
        <p><a class="font-semibold text-white hover:text-kuroki-orange" href={contactConfig.linkedin}>LinkedIn</a></p>
      </address>
    </div>
    <form class="rounded-lg border border-white/10 bg-white/[0.04] p-5 sm:p-6" action={contactConfig.formEndpoint} method="post" data-reveal>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-2 text-sm font-semibold text-white">Nombre<input required name="name" autocomplete="name" class="min-h-12 rounded-md border border-white/15 bg-kuroki-black px-4 text-white" /></label>
        <label class="grid gap-2 text-sm font-semibold text-white">Correo<input required type="email" name="email" autocomplete="email" class="min-h-12 rounded-md border border-white/15 bg-kuroki-black px-4 text-white" /></label>
      </div>
      <label class="mt-5 grid gap-2 text-sm font-semibold text-white">Tipo de proyecto
        <select name="projectType" class="min-h-12 rounded-md border border-white/15 bg-kuroki-black px-4 text-white">
          <option>Presencia digital</option>
          <option>Automatizacion</option>
          <option>Software a medida</option>
          <option>No estoy seguro</option>
        </select>
      </label>
      <label class="mt-5 grid gap-2 text-sm font-semibold text-white">Mensaje<textarea required name="message" rows="6" class="rounded-md border border-white/15 bg-kuroki-black px-4 py-3 text-white"></textarea></label>
      <button class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-md border border-kuroki-orange bg-kuroki-orange px-5 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-kuroki-black" type="submit">
        Enviar proyecto
      </button>
    </form>
  </Container>
</section>
