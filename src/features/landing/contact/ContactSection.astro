---
import Container from "@shared/ui/Container.astro";
import { contactConfig } from "@shared/config/contact.config";
---

<section id="contacto" class="contact-editorial bg-kuroki-black text-white">
  <Container class="max-w-[1680px]">
    <div class="contact-editorial__layout">
      <div class="contact-editorial__intro" data-reveal>
        <p>CONTACTO</p>
        <h2>Cuéntanos qué quieres resolver.</h2>
        <span>No necesitas llegar con la solución definida. Cuéntanos qué está pasando y veremos el siguiente paso.</span>

        <address class="contact-editorial__email">
          <span>Correo</span>
          <a href={`mailto:${contactConfig.email}`}>{contactConfig.email}</a>
        </address>
      </div>

      <form class="contact-editorial__form" action={contactConfig.formEndpoint} method="post" data-reveal>
        <div class="contact-editorial__grid">
          <label class="contact-editorial__field">
            <span>Nombre</span>
            <input required name="name" autocomplete="name" />
          </label>

          <label class="contact-editorial__field">
            <span>Correo</span>
            <input required type="email" name="email" autocomplete="email" />
          </label>
        </div>

        <label class="contact-editorial__field">
          <span>¿Qué quieres mejorar?</span>
          <select name="projectType">
            <option>Landing</option>
            <option>Automatización</option>
            <option>Software a medida</option>
            <option>No estoy seguro</option>
          </select>
        </label>

        <label class="contact-editorial__field">
          <span>Contexto breve</span>
          <textarea required name="message" rows="4" placeholder="Qué pasa hoy y qué resultado buscas."></textarea>
        </label>

        <button class="contact-editorial__submit" type="submit">
          <span>Cuéntanos tu proyecto</span>
          <span aria-hidden="true">↗</span>
        </button>
      </form>
    </div>
  </Container>
</section>
