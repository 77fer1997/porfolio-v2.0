---
import type { HeroProjectSlide } from "./hero.data";

interface Props {
  slides: HeroProjectSlide[];
}

const { slides } = Astro.props;
const slideCount = slides.length;
---

<div class="hero-project-carousel" data-hero-carousel tabindex="0" aria-label="Trabajos recientes de KUROKI">
  <div class="hero-project-carousel__halo" aria-hidden="true"></div>
  <div class="hero-project-carousel__frame">
    <div class="hero-project-carousel__topbar">
      <div class="hero-project-carousel__dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <span data-carousel-title>{slides[0]?.name}</span>
    </div>

    <div class="hero-project-carousel__viewport">
      {slides.map((slide, index) => {
        const isActive = index === 0;
        return (
          <article
            class:list={["hero-project-carousel__slide", isActive && "is-active"]}
            data-carousel-slide
            data-slide-index={index}
            aria-hidden={isActive ? "false" : "true"}
          >
            <a href={slide.href} tabindex={isActive ? 0 : -1} aria-label={`Ver caso ${slide.name}`}>
              <img
                src={isActive ? slide.image : undefined}
                data-src={slide.image}
                width={slide.width}
                height={slide.height}
                alt={slide.imageAlt}
                loading={isActive ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={isActive ? "high" : "auto"}
              />
            </a>
            <footer class="hero-project-carousel__caption">
              <div>
                <strong>{slide.name}</strong>
                <span>{slide.category}</span>
              </div>
            </footer>
          </article>
        );
      })}
    </div>
  </div>

  <div class="hero-project-carousel__controls">
    <span class="hero-project-carousel__counter" data-carousel-counter>{`01 / ${String(slideCount).padStart(2, "0")}`}</span>
    <div class="hero-project-carousel__buttons">
      <button type="button" data-carousel-prev aria-label="Proyecto anterior">
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" data-carousel-toggle aria-label="Pausar carrusel" aria-pressed="false">
        <span data-carousel-toggle-icon aria-hidden="true">Ⅱ</span>
      </button>
      <button type="button" data-carousel-next aria-label="Proyecto siguiente">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <div class="hero-project-carousel__selectors" role="tablist" aria-label="Seleccionar proyecto">
    {
      slides.map((slide, index) => (
        <button
          type="button"
          role="tab"
          aria-label={`Mostrar ${slide.name}`}
          aria-selected={index === 0 ? "true" : "false"}
          data-carousel-selector
          data-slide-index={index}
        >
          <span></span>
        </button>
      ))
    }
  </div>
</div>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-hero-carousel]");

  carousels.forEach((carousel) => {
    if (carousel.dataset.initialized === "true") return;
    carousel.dataset.initialized = "true";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const selectors = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-selector]"));
    const prevButton = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const nextButton = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const toggleButton = carousel.querySelector<HTMLButtonElement>("[data-carousel-toggle]");
    const toggleIcon = carousel.querySelector<HTMLElement>("[data-carousel-toggle-icon]");
    const counter = carousel.querySelector<HTMLElement>("[data-carousel-counter]");
    const title = carousel.querySelector<HTMLElement>("[data-carousel-title]");

    let activeIndex = 0;
    let timer: number | undefined;
    let userPaused = reduceMotion.matches;
    let interactionPaused = false;
    let visible = true;

    const total = slides.length;
    const pad = (value: number) => String(value).padStart(2, "0");

    const loadSlideImage = (index: number) => {
      const image = slides[index]?.querySelector<HTMLImageElement>("img[data-src]");
      if (image && !image.currentSrc && image.dataset.src) {
        image.src = image.dataset.src;
      }
    };

    const updateToggle = () => {
      if (!toggleButton || !toggleIcon) return;
      toggleButton.setAttribute("aria-pressed", String(userPaused));
      toggleButton.setAttribute("aria-label", userPaused ? "Reanudar carrusel" : "Pausar carrusel");
      toggleIcon.textContent = userPaused ? "▶" : "Ⅱ";
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const shouldRun = () => !userPaused && !interactionPaused && visible && !document.hidden && !reduceMotion.matches && total > 1;

    const start = () => {
      stop();
      if (!shouldRun()) return;
      timer = window.setInterval(() => setActive(activeIndex + 1), 6000);
    };

    function setActive(nextIndex: number) {
      if (total === 0) return;
      const normalizedIndex = (nextIndex + total) % total;
      if (normalizedIndex === activeIndex) return;

      loadSlideImage(normalizedIndex);
      activeIndex = normalizedIndex;

      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
        slide.querySelectorAll<HTMLElement>("a, button").forEach((item) => {
          item.tabIndex = isActive ? 0 : -1;
        });
      });

      selectors.forEach((selector, index) => {
        selector.setAttribute("aria-selected", String(index === activeIndex));
      });

      const activeSlide = slides[activeIndex];
      const activeName = activeSlide?.querySelector("strong")?.textContent ?? "";
      if (counter) counter.textContent = `${pad(activeIndex + 1)} / ${pad(total)}`;
      if (title) title.textContent = activeName;
      start();
    }

    prevButton?.addEventListener("click", () => setActive(activeIndex - 1));
    nextButton?.addEventListener("click", () => setActive(activeIndex + 1));
    toggleButton?.addEventListener("click", () => {
      userPaused = !userPaused;
      updateToggle();
      start();
    });

    selectors.forEach((selector) => {
      selector.addEventListener("click", () => {
        const index = Number(selector.dataset.slideIndex ?? 0);
        setActive(index);
      });
    });

    carousel.addEventListener("mouseenter", () => {
      interactionPaused = true;
      stop();
    });
    carousel.addEventListener("mouseleave", () => {
      interactionPaused = false;
      start();
    });
    carousel.addEventListener("focusin", () => {
      interactionPaused = true;
      stop();
    });
    carousel.addEventListener("focusout", () => {
      interactionPaused = false;
      start();
    });
    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === "Home") {
        event.preventDefault();
        setActive(0);
      } else if (event.key === "End") {
        event.preventDefault();
        setActive(total - 1);
      }
    });

    const handleVisibility = () => {
      if (document.hidden) {
        stop();
      } else {
        start();
      }
    };

    document.addEventListener("visibilitychange", handleVisibility);

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        if (visible) {
          start();
        } else {
          stop();
        }
      },
      { threshold: 0.35 },
    );
    observer.observe(carousel);

    const handleMotionChange = () => {
      userPaused = reduceMotion.matches || userPaused;
      updateToggle();
      start();
    };
    reduceMotion.addEventListener("change", handleMotionChange);

    updateToggle();
    start();

    document.addEventListener(
      "astro:before-swap",
      () => {
        stop();
        observer.disconnect();
        document.removeEventListener("visibilitychange", handleVisibility);
        reduceMotion.removeEventListener("change", handleMotionChange);
      },
      { once: true },
    );
  });
</script>

<style>
  .hero-project-carousel {
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 660px;
    color: #f5f3ef;
  }

  .hero-project-carousel__halo {
    position: absolute;
    inset: -12% -8% 12%;
    z-index: -1;
    border-radius: 999px;
    background:
      radial-gradient(circle at 58% 48%, rgba(255, 80, 4, 0.25), transparent 36%),
      radial-gradient(circle at 22% 74%, rgba(255, 255, 255, 0.08), transparent 34%);
    filter: blur(22px);
    opacity: 0.82;
  }

  .hero-project-carousel__frame {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: #1a1816;
    box-shadow: 0 28px 78px rgba(0, 0, 0, 0.38);
  }

  .hero-project-carousel__topbar {
    display: flex;
    min-height: 48px;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    padding: 0 16px;
    color: rgba(245, 243, 239, 0.72);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .hero-project-carousel__dots {
    display: inline-flex;
    gap: 7px;
  }

  .hero-project-carousel__dots span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgba(245, 243, 239, 0.2);
  }

  .hero-project-carousel__dots span:first-child {
    background: #ff5004;
  }

  .hero-project-carousel__viewport {
    position: relative;
    aspect-ratio: 16 / 12;
    overflow: hidden;
    background: #0f0e0d;
  }

  .hero-project-carousel__slide {
    position: absolute;
    inset: 0;
    display: grid;
    opacity: 0;
    pointer-events: none;
    transition: opacity 560ms ease;
  }

  .hero-project-carousel__slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  .hero-project-carousel__slide a,
  .hero-project-carousel__slide img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-project-carousel__slide img {
    object-fit: cover;
    object-position: center;
    background: #1a1816;
  }

  .hero-project-carousel__slide:nth-child(1) img {
    object-position: 50% 44%;
  }

  .hero-project-carousel__slide:nth-child(2) img {
    object-position: 50% 22%;
  }

  .hero-project-carousel__slide:nth-child(3) img {
    object-position: 50% 42%;
  }

  .hero-project-carousel__caption {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: rgba(18, 16, 14, 0.84);
    padding: 14px 16px;
    backdrop-filter: blur(14px);
  }

  .hero-project-carousel__caption strong,
  .hero-project-carousel__caption span {
    display: block;
  }

  .hero-project-carousel__caption strong {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.1;
  }

  .hero-project-carousel__caption span {
    margin-top: 4px;
    color: #c9c5c0;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .hero-project-carousel__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 18px;
  }

  .hero-project-carousel__counter {
    color: #c9c5c0;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .hero-project-carousel__buttons,
  .hero-project-carousel__selectors {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero-project-carousel__buttons button,
  .hero-project-carousel__selectors button {
    display: grid;
    min-width: 44px;
    min-height: 44px;
    place-items: center;
    border: 1px solid rgba(245, 243, 239, 0.16);
    border-radius: 999px;
    color: #f5f3ef;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .hero-project-carousel__buttons button:hover,
  .hero-project-carousel__buttons button:focus-visible,
  .hero-project-carousel__selectors button:hover,
  .hero-project-carousel__selectors button:focus-visible {
    border-color: rgba(255, 80, 4, 0.88);
    background: rgba(255, 80, 4, 0.16);
  }

  .hero-project-carousel__selectors {
    margin-top: 10px;
  }

  .hero-project-carousel__selectors button span {
    width: 22px;
    height: 3px;
    border-radius: 999px;
    background: rgba(245, 243, 239, 0.28);
  }

  .hero-project-carousel__selectors button[aria-selected="true"] span {
    background: #ff5004;
  }

  @media (max-width: 767px) {
    .hero-project-carousel__viewport {
      aspect-ratio: 4 / 3.35;
    }

    .hero-project-carousel__controls {
      align-items: flex-start;
    }

    .hero-project-carousel__caption {
      right: 12px;
      bottom: 12px;
      left: 12px;
      padding: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-project-carousel__slide {
      transition: none;
    }
  }
</style>
