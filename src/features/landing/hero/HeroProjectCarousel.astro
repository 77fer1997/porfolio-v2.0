---
import type { HeroProjectSlide } from "./hero.data";
import { heroBenefits } from "./hero.data";

interface Props {
  slides: HeroProjectSlide[];
}

const { slides } = Astro.props;
const slideCount = slides.length;
---

<div class="hero-project-carousel" data-hero-carousel tabindex="0" aria-label="Trabajos recientes de KUROKI">
  <div class="hero-project-carousel__frame">
    <div class="hero-project-carousel__topbar">
      <div class="hero-project-carousel__dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <span data-carousel-title>{slides[0]?.name}</span>
    </div>

    <div class="hero-project-carousel__viewport">
      {slides.map((slide, index) => {
        const isActive = index === 0;
        return (
          <article
            class:list={["hero-project-carousel__slide", isActive && "is-active"]}
            data-carousel-slide
            data-slide-index={index}
            data-project-name={slide.name}
            aria-hidden={isActive ? "false" : "true"}
          >
            <a href={slide.href} tabindex={isActive ? 0 : -1} aria-label={`Ver caso ${slide.name}`}>
              <img
                src={isActive ? slide.image : undefined}
                data-src={slide.image}
                width={slide.width}
                height={slide.height}
                alt={slide.imageAlt}
                loading={isActive ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={isActive ? "high" : "auto"}
              />
            </a>
          </article>
        );
      })}
      <span class="hero-project-carousel__counter" data-carousel-counter>{`01 / ${String(slideCount).padStart(2, "0")}`}</span>
      <div class="hero-project-carousel__progress" aria-hidden="true"><span></span></div>
    </div>
  </div>

  <ul class="hero-project-carousel__benefits">
    {heroBenefits.map((benefit) => (
      <li><span aria-hidden="true">✓</span>{benefit}</li>
    ))}
  </ul>
</div>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-hero-carousel]");

  carousels.forEach((carousel) => {
    if (carousel.dataset.initialized === "true") return;
    carousel.dataset.initialized = "true";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const counter = carousel.querySelector<HTMLElement>("[data-carousel-counter]");
    const title = carousel.querySelector<HTMLElement>("[data-carousel-title]");

    let activeIndex = 0;
    let timer: number | undefined;
    let interactionPaused = false;
    let visible = true;

    const total = slides.length;
    const pad = (value: number) => String(value).padStart(2, "0");

    const loadSlideImage = (index: number) => {
      const image = slides[index]?.querySelector<HTMLImageElement>("img[data-src]");
      if (image && !image.currentSrc && image.dataset.src) {
        image.src = image.dataset.src;
      }
    };

    const stop = () => {
      carousel.removeAttribute("data-running");
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const shouldRun = () => !interactionPaused && visible && !document.hidden && !reduceMotion.matches && total > 1;

    const start = () => {
      stop();
      if (!shouldRun()) return;
      // Restart the visual countdown together with the autoplay timer.
      void carousel.offsetWidth;
      carousel.dataset.running = "true";
      timer = window.setInterval(() => setActive(activeIndex + 1), 6000);
    };

    function setActive(nextIndex: number) {
      if (total === 0) return;
      const normalizedIndex = (nextIndex + total) % total;
      if (normalizedIndex === activeIndex) return;

      loadSlideImage(normalizedIndex);
      activeIndex = normalizedIndex;

      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
        slide.querySelectorAll<HTMLElement>("a, button").forEach((item) => {
          item.tabIndex = isActive ? 0 : -1;
        });
      });

      const activeSlide = slides[activeIndex];
      const activeName = activeSlide?.dataset.projectName ?? "";
      if (counter) counter.textContent = `${pad(activeIndex + 1)} / ${pad(total)}`;
      if (title) title.textContent = activeName;
      start();
    }

    carousel.addEventListener("mouseenter", () => {
      interactionPaused = true;
      stop();
    });
    carousel.addEventListener("mouseleave", () => {
      interactionPaused = carousel.contains(document.activeElement);
      start();
    });
    carousel.addEventListener("focusin", () => {
      interactionPaused = true;
      stop();
    });
    carousel.addEventListener("focusout", () => {
      queueMicrotask(() => {
        interactionPaused = carousel.matches(":hover") || carousel.contains(document.activeElement);
        start();
      });
    });
    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === "Home") {
        event.preventDefault();
        setActive(0);
      } else if (event.key === "End") {
        event.preventDefault();
        setActive(total - 1);
      }
    });

    const handleVisibility = () => {
      if (document.hidden) {
        stop();
      } else {
        start();
      }
    };

    document.addEventListener("visibilitychange", handleVisibility);

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        if (visible) {
          start();
        } else {
          stop();
        }
      },
      { threshold: 0.35 },
    );
    observer.observe(carousel);

    const handleMotionChange = () => {
      start();
    };
    reduceMotion.addEventListener("change", handleMotionChange);

    start();

    document.addEventListener(
      "astro:before-swap",
      () => {
        stop();
        observer.disconnect();
        document.removeEventListener("visibilitychange", handleVisibility);
        reduceMotion.removeEventListener("change", handleMotionChange);
      },
      { once: true },
    );
  });
</script>

<style>
  @property --hero-frame-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  .hero-project-carousel {
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 660px;
    color: #f5f3ef;
    animation: carousel-enter 1000ms cubic-bezier(0.22, 1, 0.36, 1) 250ms both;
  }

  @keyframes carousel-enter {
    from { opacity: 0; transform: translateY(30px) rotate(1deg); }
    to { opacity: 1; transform: translateY(0) rotate(0); }
  }

  .hero-project-carousel__progress {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 4;
    height: 2px;
    overflow: hidden;
    background: rgba(245, 243, 239, 0.12);
  }

  .hero-project-carousel__progress span {
    display: block;
    height: 100%;
    background: #3dbddf;
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero-project-carousel[data-running] .hero-project-carousel__progress span {
    animation: carousel-countdown 6s linear forwards;
  }

  @keyframes carousel-countdown {
    to { transform: scaleX(1); }
  }

  @keyframes project-drift {
    from { transform: scale(1); }
    to { transform: scale(1.035); }
  }

  .hero-project-carousel__frame {
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 8px;
    background:
      linear-gradient(#171b1d, #171b1d) padding-box,
      conic-gradient(from var(--hero-frame-angle), #243f47 0deg, #243f47 240deg, #3dbddf 290deg, #8ddcf0 310deg, #243f47 350deg) border-box;
    box-shadow: 0 28px 78px rgba(0, 0, 0, 0.38), 0 0 24px rgba(61, 189, 223, 0.06);
    animation: frame-trace 7s linear infinite paused;
  }

  .hero-project-carousel[data-running] .hero-project-carousel__frame {
    animation-play-state: running;
  }

  @keyframes frame-trace {
    to { --hero-frame-angle: 360deg; }
  }

  .hero-project-carousel__benefits {
    display: grid;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    color: #c9c5c0;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .hero-project-carousel__benefits li {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .hero-project-carousel__benefits li span {
    flex-shrink: 0;
    color: #3dbddf;
    font-weight: 800;
  }

  .hero-project-carousel__topbar {
    display: flex;
    min-height: 48px;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    padding: 0 16px;
    color: rgba(245, 243, 239, 0.72);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .hero-project-carousel__dots {
    display: inline-flex;
    gap: 7px;
  }

  .hero-project-carousel__dots span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgba(245, 243, 239, 0.2);
  }

  .hero-project-carousel__dots span:first-child {
    background: #3dbddf;
  }

  .hero-project-carousel__viewport {
    position: relative;
    aspect-ratio: 16 / 12;
    overflow: hidden;
    background: #0f0e0d;
  }

  .hero-project-carousel__viewport::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 3;
    height: 64px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
    pointer-events: none;
    content: "";
  }

  .hero-project-carousel__slide {
    position: absolute;
    inset: 0;
    display: grid;
    opacity: 0;
    pointer-events: none;
    transition: opacity 560ms ease;
  }

  .hero-project-carousel__slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  .hero-project-carousel__slide.is-active img {
    animation: project-drift 8s ease-in-out both;
    animation-play-state: paused;
  }

  .hero-project-carousel[data-running] .hero-project-carousel__slide.is-active img {
    animation-play-state: running;
  }

  .hero-project-carousel__slide a,
  .hero-project-carousel__slide img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-project-carousel__slide img {
    object-fit: cover;
    object-position: center;
    background: #171b1d;
  }

  .hero-project-carousel__slide:nth-child(1) img {
    object-position: 50% 44%;
  }

  .hero-project-carousel__slide:nth-child(2) img {
    object-position: 50% 22%;
  }

  .hero-project-carousel__slide:nth-child(3) img {
    object-position: 50% 42%;
  }

  .hero-project-carousel__counter {
    position: absolute;
    bottom: 16px;
    left: 18px;
    z-index: 4;
    color: #f5f3ef;
    font-size: 0.82rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 1600px) {
    .hero-project-carousel {
      max-width: none;
    }

    .hero-project-carousel__viewport {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 767px) {
    .hero-project-carousel__viewport {
      aspect-ratio: 4 / 3.35;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .hero-project-carousel,
    .hero-project-carousel__frame,
    .hero-project-carousel__slide.is-active img,
    .hero-project-carousel[data-running] .hero-project-carousel__progress span {
      animation: none;
    }

    .hero-project-carousel__slide {
      transition: none;
    }
  }
</style>
