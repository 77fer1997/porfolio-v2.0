<div class="hero-figure" aria-hidden="true" data-hero-figure>
  <div class="hero-product-scene" data-hero-product-scene>
    <div class="hero-product-scene__halo"></div>

    <section class="hero-product-panel hero-product-panel--main" data-hero-visual-layer>
      <header class="hero-product-panel__header">
        <div>
          <span class="hero-product-panel__eyebrow">Sistema operativo</span>
          <strong>Operación comercial</strong>
        </div>
        <span class="hero-product-panel__status">Activo</span>
      </header>

      <div class="hero-product-flow">
        <div class="hero-product-flow__item is-done">
          <span>01</span>
          <strong>Pedido recibido</strong>
        </div>
        <div class="hero-product-flow__item is-done">
          <span>02</span>
          <strong>Validación</strong>
        </div>
        <div class="hero-product-flow__item is-active">
          <span>03</span>
          <strong>Inventario</strong>
        </div>
        <div class="hero-product-flow__item">
          <span>04</span>
          <strong>Facturación</strong>
        </div>
        <div class="hero-product-flow__item">
          <span>05</span>
          <strong>Completado</strong>
        </div>
      </div>

      <div class="hero-product-panel__grid">
        <div class="hero-product-chart">
          <span style="--bar: 64%"></span>
          <span style="--bar: 48%"></span>
          <span style="--bar: 76%"></span>
          <span style="--bar: 58%"></span>
          <span style="--bar: 88%"></span>
        </div>
        <div class="hero-product-list">
          <span><i></i> Stock reservado automáticamente</span>
          <span><i></i> Cliente notificado</span>
          <span><i></i> Documento listo para emitir</span>
        </div>
      </div>

      <div class="hero-product-insights">
        <div>
          <span>Pedidos hoy</span>
          <strong>128</strong>
        </div>
        <div>
          <span>Revisión manual</span>
          <strong>-72%</strong>
        </div>
        <div>
          <span>Tiempo ahorrado</span>
          <strong>42h</strong>
        </div>
      </div>
    </section>

    <aside class="hero-product-panel hero-product-panel--float" data-hero-visual-layer>
      <span>Automatización</span>
      <strong>72%</strong>
      <small>menos revisión manual</small>
    </aside>

    <aside class="hero-product-panel hero-product-panel--side" data-hero-visual-layer>
      <div class="hero-product-panel__mini-header"></div>
      <span>Soporte</span>
      <strong>Operación estable</strong>
      <p>Seguimiento claro para equipos reales.</p>
    </aside>
  </div>
</div>
