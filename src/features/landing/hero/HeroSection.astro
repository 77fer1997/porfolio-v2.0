---
import { contactConfig } from "@shared/config/contact.config";
import { heroContent } from "./hero.data";
const whatsappHref = `${contactConfig.whatsappHref}?text=${encodeURIComponent(heroContent.whatsappMessage)}`;
const ridgeHeight = (x: number) => {
  const distance = Math.abs(x - 51);
  if (distance < 7) return 16 + Math.sin(x * 0.7) * 1.4;
  const slope = Math.min(1, (distance - 7) / 38);
  return 82 - 64 * Math.pow(1 - slope, 1.55);
};
const particles = Array.from({ length: 208 }, (_, index) => {
  const ridge = index < 96;
  const loose = index >= 190;
  const along = ridge ? index / 95 : ((index * 67) % 191) / 190;
  const x = 6 + along * 90;
  const surface = ridgeHeight(x);
  const fill = ((index * 43) % 97) / 96;
  const depth = index % 3;
  const accent = index % (ridge ? 4 : 3) === 0;
  return {
    x: x + Math.sin(index * 7.13) * (loose ? 5 : 0.6),
    y: loose ? 9 + fill * 83 : ridge ? surface + Math.sin(index * 4.7) * 1.8 : surface + 3 + fill * (85 - surface),
    size: ridge ? [2, 2.6, 3][depth] : [1.5, 2.5, 4][depth],
    opacity: accent ? 0.9 : loose ? 0.35 : ridge ? [0.85, 0.95, 1][depth] : [0.25, 0.4, 0.65][depth],
    driftX: loose ? 12 : [3, -4, 5][depth],
    driftY: loose ? -20 : [-4, 5, -6][depth],
    duration: 3.5 + (index % 7) * 0.65,
    delay: -(index * 2.3),
    accent,
  };
});
const mountainDetails = Array.from({ length: 250 }, (_, index) => {
  const base = index < 100;
  const foothill = index >= 210;
  const snow = index >= 100 && index < 140;
  const lane = Math.floor((index - 140) / 14);
  const progress = ((index - 140) % 14) / 13;
  const x = base ? 5 + index * 0.92 : foothill ? 15 + (index - 210) * 1.8 : snow ? 37 + (index - 100) * 0.72 : 42 + lane * 4.5 + (lane - 2) * progress * 8;
  const y = base ? 85 + Math.sin(index * 0.12) * 1.6 + Math.sin(index * 0.37) * 0.7 + Math.cos(index * 1.7) * 0.35 : foothill ? 91 + Math.sin(index * 0.22) * 1.2 + Math.sin(index * 0.61) * 0.5 : snow ? 34 + Math.sin(index * 0.54) * 3 + Math.sin(index * 0.21) * 2 : 38 + progress * 44 + Math.sin(progress * 6 + lane) * 2;
  const edgeFade = Math.pow(Math.max(0, Math.sin(Math.PI * (base ? index / 99 : (index - 210) / 39))), 0.6);
  return {
    x: base || foothill ? x + Math.sin(index * 2.3) * 0.2 : x,
    y,
    size: snow ? 2 : base ? 1.8 : 1.4,
    opacity: base ? 0.75 * edgeFade : snow ? 0.95 : foothill ? 0.3 * edgeFade : 0.35,
    accent: base ? index % 4 === 0 : !snow && index % 7 === 0,
  };
});
const smokePoints = Array.from({ length: 72 }, (_, index) => {
  const height = (index % 18) / 17;
  return {
    x: 51 + Math.sin(index * 2.17) * (0.8 + height * 2.8),
    y: 16 + Math.sin(index * 4.3) * 1.8,
    size: [2.4, 3, 3.6][index % 3],
    opacity: 0.48 + (index % 4) * 0.08,
    driftX: Math.sin(index * 3.1) * (14 + height * 34),
    driftY: -(30 + height * 108),
    duration: 5.5 + (index % 6) * 0.65,
    delay: -(index * 0.55),
    accent: index % 11 === 0,
  };
});
---
<section id="inicio" class="hero-web" data-hero-web>
  <div class="hero-web__particles" aria-hidden="true">
    {mountainDetails.map((point) => (
      <span
        class:list={["hero-web__mountain-detail", { "hero-web__particle--accent": point.accent }]}
        style={`--x:${point.x}%;--y:${point.y}%;--size:${point.size}px;--opacity:${point.opacity};`}
      />
    ))}
    {particles.map((particle) => (
      <span
        class:list={["hero-web__particle", { "hero-web__particle--accent": particle.accent }]}
        style={`--x:${particle.x}%;--y:${particle.y}%;--size:${particle.size}px;--opacity:${particle.opacity};--drift-x:${particle.driftX}px;--drift-y:${particle.driftY}px;--duration:${particle.duration}s;--delay:${particle.delay}s;`}
      />
    ))}
    {smokePoints.map((point) => (
      <span
        class:list={["hero-web__smoke-point", { "hero-web__particle--accent": point.accent }]}
        style={`--x:${point.x}%;--y:${point.y}%;--size:${point.size}px;--opacity:${point.opacity};--drift-x:${point.driftX}px;--drift-y:${point.driftY}px;--duration:${point.duration}s;--delay:${point.delay}s;`}
      />
    ))}
  </div>
  <div class="hero-web__container">
    <div class="hero-web__content">
      <p class="hero-web__eyebrow">{heroContent.eyebrow}</p>
      <h1><span>Soluciones digitales</span><span>para tu negocio.</span></h1>
      <div class="hero-web__details">
        <p class="hero-web__description">{heroContent.description}</p>
        <div class="hero-web__actions">
          <a href={whatsappHref} class="hero-web__primary" target="_blank" rel="noreferrer">{heroContent.primaryCta} <span aria-hidden="true">&nearr;</span></a>
        </div>
      </div>
    </div>
    <div class="hero-web__footer">
      <a href="#casos-de-exito" class="hero-web__cases-link">{heroContent.secondaryCta}</a>
      <a href="#casos-de-exito" class="hero-web__scroll-link" aria-label="Ver proyectos seleccionados" title="Ver proyectos">
        <span class="hero-web__mouse" aria-hidden="true"><span class="hero-web__wheel"></span></span>
      </a>
    </div>
  </div>
</section>
<style>
  .hero-web { position: relative; overflow: clip; background: #0d0d0d; color: #fff; font-family: var(--font-sans); letter-spacing: 0; }
  .hero-web__container { position: relative; display: flex; flex-direction: column; justify-content: center; width: 100%; min-height: max(680px, 100svh); padding: 128px clamp(24px, 4vw, 72px); }
  .hero-web__content { width: 100%; max-width: 1576px; margin-inline: auto; }
  .hero-web__particles { position: absolute; top: 46%; right: 3%; width: 39%; height: 35%; pointer-events: none; transform-origin: 50% 80%; animation: hero-mountain-float 8s ease-in-out infinite alternate; }
  .hero-web__particle { position: absolute; left: var(--x); top: var(--y); width: var(--size); height: var(--size); border-radius: 50%; background: #dedede; opacity: var(--opacity); animation: hero-particle-drift var(--duration) ease-in-out var(--delay) infinite alternate, hero-particle-shimmer calc(var(--duration) * 1.4) ease-in-out var(--delay) infinite alternate; }
  .hero-web__mountain-detail { position: absolute; left: var(--x); top: var(--y); width: var(--size); height: var(--size); border-radius: 50%; background: #dedede; opacity: var(--opacity); }
  .hero-web__particle--accent { background: #3dbddf; box-shadow: 0 0 6px #3dbddf70; }
  .hero-web__smoke-point { position: absolute; left: var(--x); top: var(--y); width: var(--size); height: var(--size); border-radius: 50%; background: #d6e1e7; opacity: var(--opacity); animation: hero-smoke-point var(--duration) ease-out var(--delay) infinite; }
  @keyframes hero-mountain-float { from { transform: translateY(4px) rotate(-0.6deg); } to { transform: translateY(-9px) rotate(0.6deg); } }
  @keyframes hero-smoke-point { 0% { opacity: var(--opacity); transform: translate3d(0, 0, 0) scale(.7); } 72% { opacity: calc(var(--opacity) * .55); } 100% { opacity: 0; transform: translate3d(var(--drift-x), var(--drift-y), 0) scale(.8); } }
  @keyframes hero-particle-shimmer { from { opacity: calc(var(--opacity) * 0.72); } to { opacity: var(--opacity); } }
  @keyframes hero-particle-drift { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(var(--drift-x), var(--drift-y), 0); } }
  .hero-web__eyebrow { animation: hero-enter 900ms var(--motion-ease) 100ms both; }
  .hero-web h1 > span { animation: hero-title-enter 1100ms var(--motion-ease) 220ms both; }
  .hero-web h1 > span + span { animation-delay: 380ms; }
  .hero-web__details { animation: hero-enter 1000ms var(--motion-ease) 620ms both; }
  .hero-web__footer a { animation: hero-enter 900ms var(--motion-ease) 950ms both; }
  .hero-web__eyebrow { margin: 0 0 32px; color: #a8a8a8; font-size: 12px; font-weight: 500; line-height: 1.5; letter-spacing: 0; }
  .hero-web h1 { margin: 0; font-size: 80px; font-weight: 500; line-height: 1.12; letter-spacing: 0; }
  .hero-web h1 > span { display: block; }
  .hero-web__details { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; max-width: 640px; margin-top: 36px; }
  .hero-web__description { max-width: 580px; margin: 0; color: #b5b5b5; font-size: 20px; line-height: 1.6; }
  .hero-web__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 48px; }
  .hero-web__primary { display: inline-flex; flex-shrink: 0; min-height: 56px; align-items: center; gap: 28px; padding: 16px 22px; border: 1px solid #3dbddf; border-radius: 4px; background: transparent; color: #f5f5f5; font-size: 16px; font-weight: 500; line-height: 1.4; text-decoration: none; transition: border-color 250ms ease, color 250ms ease; }
  .hero-web__primary > span { color: #3dbddf; font-size: 24px; transition: transform 350ms var(--motion-ease); }
  .hero-web__primary:is(:hover, :focus-visible) { background: transparent; color: #ffffff; }
  .hero-web__primary:focus-visible, .hero-web__footer a:focus-visible { outline: 2px solid #3dbddf; outline-offset: 6px; }
  .hero-web__primary:is(:hover, :focus-visible) > span { transform: translate(3px, -3px); }
  .hero-web__footer { position: absolute; bottom: 0; inset-inline: 0; display: flex; min-height: 124px; flex-direction: column; align-items: center; justify-content: center; gap: 0; padding-bottom: 8px; box-sizing: border-box; }
  .hero-web__footer a { color: #858585; text-decoration: none; transition: color 250ms ease; }
  .hero-web__footer .hero-web__cases-link { display: inline-flex; min-height: 38px; align-items: center; color: #c4c4c4; font-size: 13px; font-weight: 500; }
  .hero-web__footer .hero-web__cases-link:hover { color: #fff; }
  .hero-web__scroll-link { display: grid; width: 48px; height: 48px; place-items: center; }
  .hero-web__mouse { position: relative; display: block; width: 22px; height: 34px; border: 1px solid currentColor; border-radius: 12px; }
  .hero-web__wheel { position: absolute; top: 7px; left: 50%; width: 2px; height: 6px; margin-left: -1px; border-radius: 1px; background: #3dbddf; animation: hero-scroll-wheel 2400ms ease-in-out infinite; }
  .hero-web__footer a:is(:hover, :focus-visible) { color: #fff; }
  .hero-web__footer a:focus-visible { outline: 2px solid #3dbddf; outline-offset: 4px; }
  @keyframes hero-scroll-wheel { 0%, 20% { opacity: 0.8; transform: translateY(0); } 65% { opacity: 0; transform: translateY(9px); } 66% { opacity: 0; transform: translateY(0); } 100% { opacity: 0.8; transform: translateY(0); } }
  @keyframes hero-enter { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes hero-title-enter { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
  @media (min-width: 1600px) { .hero-web h1 { font-size: 96px; } }
  @media (max-width: 1199px) { .hero-web h1 { font-size: 64px; } .hero-web__details { gap: 32px; } .hero-web__description { font-size: 18px; } }
  @media (max-width: 767px) {
    .hero-web__container { min-height: max(600px, 100svh); padding: 120px 24px; }
    .hero-web__content { max-width: 100%; }
    .hero-web__particles { top: auto; bottom: 82px; right: 8px; width: clamp(132px, 38vw, 154px); height: clamp(110px, 32vw, 128px); opacity: 0.68; }
    .hero-web__eyebrow { max-width: 310px; margin-bottom: 22px; font-size: 11px; }
    .hero-web h1 { font-size: 34px; line-height: 1.14; }
    .hero-web__details { align-items: flex-start; flex-direction: column; gap: 24px; margin-top: 28px; }
    .hero-web__actions { gap: 16px 24px; }
    .hero-web__description { max-width: 360px; font-size: 16px; }
    .hero-web__primary { min-height: 52px; padding: 12px 18px; gap: 20px; font-size: 15px; }
    .hero-web__footer { min-height: 112px; }
  }
  @media (max-width: 374px) { .hero-web h1 { font-size: 31px; } .hero-web__primary { padding-inline: 14px; gap: 12px; font-size: 14px; } }
  @media (prefers-reduced-motion: reduce) { .hero-web__eyebrow, .hero-web h1 > span, .hero-web__details, .hero-web__footer a, .hero-web__wheel { animation: none; } .hero-web__primary, .hero-web__primary > span, .hero-web__footer a { transition: none; } }
  @media (prefers-reduced-motion: reduce) { .hero-web__particles, .hero-web__particle, .hero-web__smoke-point { animation: none; } .hero-web__smoke-point { opacity: .36; } }
</style>
