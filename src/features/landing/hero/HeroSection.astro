---
import { contactConfig } from "@shared/config/contact.config";
import HeroProjectCarousel from "./HeroProjectCarousel.astro";
import { heroContent, heroProjectSlides } from "./hero.data";

const whatsappHref = `${contactConfig.whatsappHref}?text=${encodeURIComponent(heroContent.whatsappMessage)}`;
---

<section id="inicio" class="hero-web" data-hero-web>
  <div class="hero-web__container">
    <div class="hero-web__content">
      <p class="hero-web__eyebrow">{heroContent.eyebrow}</p>
      <h1>
        Una página <wbr />web a la altura de <span>tu negocio.</span>
      </h1>
      <p class="hero-web__description">{heroContent.description}</p>

      <div class="hero-web__actions">
        <a href={whatsappHref} class="hero-web__primary" target="_blank" rel="noreferrer">
          {heroContent.primaryCta}
          <span aria-hidden="true">↗</span>
        </a>
        <a href="#casos-de-exito" class="hero-web__secondary">
          {heroContent.secondaryCta}
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <p class="hero-web__note">{heroContent.supportText}</p>
    </div>

    <HeroProjectCarousel slides={heroProjectSlides} />
  </div>
</section>

<style>
  .hero-web {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: #12100e;
    color: #f5f3ef;
  }

  .hero-web::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 78% 28%, rgba(255, 80, 4, 0.16), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent 34%);
    content: "";
  }

  .hero-web__container {
    display: grid;
    width: 100%;
    max-width: 1440px;
    min-height: clamp(720px, 92svh, 880px);
    margin: 0 auto;
    grid-template-columns: minmax(0, 0.96fr) minmax(440px, 1.04fr);
    align-items: center;
    gap: clamp(48px, 5vw, 64px);
    padding: clamp(136px, 15svh, 168px) clamp(32px, 5vw, 64px) clamp(64px, 8svh, 88px);
  }

  .hero-web__content {
    max-width: 650px;
    min-width: 0;
  }

  .hero-web__eyebrow {
    margin: 0 0 22px;
    color: #ff5004;
    font-size: clamp(0.78rem, 1.05vw, 0.92rem);
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.35;
  }

  .hero-web h1 {
    max-width: 760px;
    margin: 0;
    color: #f5f3ef;
    font-size: clamp(3.5rem, 5.2vw, 4.75rem);
    font-weight: 800;
    line-height: 0.96;
    overflow-wrap: break-word;
  }

  .hero-web h1 span {
    color: #ff5004;
  }

  .hero-web__description {
    max-width: 620px;
    margin: 28px 0 0;
    color: #c9c5c0;
    font-size: clamp(1rem, 1.22vw, 1.16rem);
    font-weight: 500;
    line-height: 1.78;
    overflow-wrap: break-word;
  }

  .hero-web__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .hero-web__primary,
  .hero-web__secondary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 8px;
    padding: 0.88rem 1.08rem;
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .hero-web__primary {
    border: 1px solid rgba(255, 80, 4, 0.96);
    background: #ff5004;
    color: #ffffff;
    box-shadow: 0 18px 38px rgba(255, 80, 4, 0.24);
  }

  .hero-web__secondary {
    border: 1px solid rgba(245, 243, 239, 0.16);
    color: #f5f3ef;
  }

  .hero-web__primary:hover,
  .hero-web__secondary:hover {
    transform: translateY(-2px);
  }

  .hero-web__primary:hover {
    background: #e94803;
  }

  .hero-web__secondary:hover {
    border-color: rgba(255, 80, 4, 0.8);
    color: #ff5004;
  }

  .hero-web__note {
    margin: 22px 0 0;
    color: rgba(201, 197, 192, 0.78);
    font-size: 0.86rem;
    font-weight: 700;
  }

  @media (max-width: 1023px) {
    .hero-web__container {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 44px;
      padding-top: 128px;
    }

    .hero-web__content,
    .hero-web__description {
      max-width: 720px;
    }
  }

  @media (max-width: 767px) {
    .hero-web__container {
      padding-top: 116px;
      padding-right: 20px;
      padding-bottom: 60px;
      padding-left: 20px;
    }

    .hero-web h1 {
      font-size: clamp(2.25rem, 10.2vw, 2.65rem);
      line-height: 1.02;
    }

    .hero-web__description {
      margin-top: 22px;
      font-size: 1rem;
      line-height: 1.68;
    }

    .hero-web__actions {
      display: grid;
      grid-template-columns: 1fr;
      margin-top: 28px;
    }
  }
</style>
