---
import Button from "@shared/ui/Button.astro";
import Container from "@shared/ui/Container.astro";
import HeroAmbient from "./HeroAmbient.astro";
import { heroContent } from "./hero.data";
---

<section
  id="inicio"
  class="relative flex min-h-screen items-center overflow-hidden bg-kuroki-black bg-cover bg-center py-28 sm:py-32 lg:py-24"
  style="background-image: url('/images/brand/fondo-kuroki.png');"
>
  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(13,13,13,.18),rgba(13,13,13,.58))]"
    aria-hidden="true"
  >
  </div>
  <HeroAmbient />
  <Container class="relative w-full">
    <div class="mx-auto max-w-5xl animate-[kuroki-rise_.7s_ease-out_both] text-center">
      <p class="hero-sequence-item mb-5 text-xs font-extrabold uppercase tracking-[0.24em] text-kuroki-orange sm:text-sm [--hero-sequence-delay:0ms]">
        {heroContent.eyebrow}
      </p>
      <h1 class="hero-sequence-item mx-auto max-w-[980px] text-balance text-4xl font-extrabold leading-tight text-white sm:text-6xl lg:text-7xl [--hero-sequence-delay:0ms]">
        Convertimos tus procesos
        <span class="text-kuroki-orange"> en software que trabaja por ti.</span>
      </h1>
      <p class="hero-sequence-item mx-auto mt-7 max-w-3xl text-pretty text-base leading-8 text-white/78 sm:text-lg lg:text-xl [--hero-sequence-delay:320ms]">
        {heroContent.description}
      </p>
      <div class="hero-sequence-item mt-9 flex flex-col justify-center gap-3 sm:flex-row [--hero-sequence-delay:320ms]">
        <Button href="#contacto">Cuentanos tu proyecto</Button>
        <Button href="#servicios" variant="secondary">Ver como trabajamos</Button>
      </div>
      <div class="hero-sequence-item mx-auto mt-11 grid max-w-4xl gap-3 text-left sm:grid-cols-3 [--hero-sequence-delay:680ms]">
        {
          heroContent.levels.map((level, index) => (
            <div
              class:list={[
                "rounded-md border bg-white/[0.045] px-5 py-4",
                index === 0 ? "border-kuroki-orange/70" : "border-white/12",
              ]}
            >
              <p class="text-xs font-bold tracking-[0.18em] text-kuroki-orange">
                {level.number}
              </p>
              <p class="mt-2 text-sm font-semibold text-white sm:text-base">
                {level.title}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>
