---
import { faqItems } from "./faq.data";
---
<section id="preguntas" class="studio-faq" aria-labelledby="faq-title">
  <div class="faq-wrap">
    <header>
      <p class="faq-label">PREGUNTAS FRECUENTES</p>
      <h2 id="faq-title">Antes del<br />siguiente paso.</h2>
      <a href="#contacto">¿Tienes otra pregunta? <span aria-hidden="true">&nearr;</span></a>
    </header>
    <div class="faq-questions">
      {faqItems.map((item, index) => (
        <details open={index === 0}>
          <summary><span>{item.question}</span><i aria-hidden="true"></i></summary>
          <div class="faq-answer"><div class="faq-answer__inner"><p>{item.answer}</p></div></div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .studio-faq { padding-block: 80px; background: #f5f5f3; color: #171717; scroll-margin-top: 80px; }
  .faq-wrap { width: calc(100% - clamp(48px, 8vw, 144px)); max-width: 1576px; margin-inline: auto; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 80px; }
  .faq-label { color: #126d84; margin: 0 0 24px; font-size: 12px; font-weight: 600; }
  h2 { margin: 0; font-size: 40px; font-weight: 500; line-height: 1.2; }
  header a { display: inline-flex; min-height: 44px; align-items: center; gap: 16px; margin-top: 30px; color: #555; font-size: 14px; line-height: 1.6; text-decoration: none; }
  header a span { color: #126d84; font-size: 20px; }
  .faq-questions { border-top: 1px solid #17171730; min-width: 0; }
  details { border-bottom: 1px solid #17171730; }
  summary { display: flex; justify-content: space-between; gap: 28px; align-items: start; padding-block: 23px; cursor: pointer; list-style: none; font-size: 19px; font-weight: 500; line-height: 1.45; }
  summary::-webkit-details-marker { display: none; }
  summary i { position: relative; display: block; width: 20px; height: 20px; flex: 0 0 20px; margin-top: 3px; }
  summary i::before, summary i::after { content: ''; position: absolute; top: 9px; left: 2px; width: 16px; height: 1px; background: currentColor; }
  summary i::after { transform: rotate(90deg); transition: transform 260ms var(--motion-ease); }
  details[open] summary i { color: #126d84; }
  details[open] summary i::after { transform: rotate(0); }
  .faq-answer { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 360ms var(--motion-ease), opacity 240ms ease; }
  details[open] .faq-answer { grid-template-rows: 1fr; opacity: 1; }
  .faq-answer__inner { min-height: 0; overflow: hidden; }
  .faq-answer p { max-width: 600px; margin: 0; padding: 0 44px 24px 0; color: #555; font-size: 15px; line-height: 1.8; }
  summary:hover, header a:hover { color: #126d84; }
  a:focus-visible, summary:focus-visible { outline: 2px solid #126d84; outline-offset: 5px; }
  @media (max-width: 1023px) { .faq-wrap { gap: 40px; } h2 { font-size: 36px; } }
  @media (max-width: 767px) { .studio-faq { padding-block: 64px; } .faq-wrap { grid-template-columns: 1fr; gap: 32px; } h2 { font-size: 32px; } summary { font-size: 18px; padding-block: 20px; gap: 16px; } header a { margin-top: 20px; } .faq-answer p { padding-right: 20px; } }
  @media (prefers-reduced-motion: reduce) { .faq-answer, summary i::after { transition: none; } }
</style>
