---
import Container from "@shared/ui/Container.astro";
import { faqItems } from "./faq.data";
---

<section id="preguntas" class="faq-editorial text-kuroki-black">
  <Container class="max-w-[1680px]">
    <div class="faq-editorial__layout">
      <div class="faq-editorial__intro" data-reveal>
        <p>PREGUNTAS</p>
        <h2>Antes de empezar.</h2>
      </div>

      <div class="faq-editorial__list" data-faq-list data-reveal-group>
        {
          faqItems.map((item, index) => {
            const panelId = `faq-panel-${index + 1}`;

            return (
              <div class:list={["faq-editorial__item", index === 0 && "is-open"]} data-faq-item data-reveal>
                <button
                  class="faq-editorial__trigger"
                  type="button"
                  aria-expanded={index === 0 ? "true" : "false"}
                  aria-controls={panelId}
                  data-faq-trigger
                >
                  <span>{item.question}</span>
                  <span class="faq-editorial__icon" aria-hidden="true">+</span>
                </button>
                <div id={panelId} class="faq-editorial__panel" data-faq-panel>
                  <div class="faq-editorial__answer">
                    <p>{item.answer}</p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </Container>
</section>

<script>
  const initFaqAccordion = () => {
    const lists = document.querySelectorAll<HTMLElement>("[data-faq-list]");

    lists.forEach((list) => {
      if (list.dataset.faqReady === "true") {
        return;
      }

      list.dataset.faqReady = "true";

      const items = Array.from(list.querySelectorAll<HTMLElement>("[data-faq-item]"));

      const setOpenItem = (activeItem: HTMLElement) => {
        items.forEach((item) => {
          const isOpen = item === activeItem;
          const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");

          item.classList.toggle("is-open", isOpen);
          trigger?.setAttribute("aria-expanded", String(isOpen));
        });
      };

      items.forEach((item) => {
        const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");

        trigger?.addEventListener("click", () => setOpenItem(item));
      });
    });
  };

  initFaqAccordion();
  document.addEventListener("astro:page-load", initFaqAccordion);
</script>
