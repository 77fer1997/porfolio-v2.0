---
import Container from "@shared/ui/Container.astro";
import { principles } from "./benefits.data";
---

<section class="bg-white py-20 text-kuroki-black sm:py-28">
  <Container class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
    <div class="max-w-3xl" data-reveal>
      <p class="mb-4 text-sm font-bold tracking-[0.18em] text-kuroki-orange">
        POR QUÉ KUROKI
      </p>
      <h2 class="max-w-[760px] text-3xl font-extrabold leading-tight text-kuroki-black sm:text-4xl lg:text-[2.65rem]">
        Criterio para decidir. Capacidad para construir.
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-8 text-kuroki-gray">
        No buscamos construir de más. Elegimos lo necesario para resolver bien el problema y dejar una base que pueda evolucionar.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2" data-reveal-group>
      {
        principles.map((principle) => (
          <article class="flex h-full flex-col rounded-lg border border-border-light bg-surface-light p-6 sm:p-7" data-reveal>
            <span class="text-sm font-extrabold text-kuroki-orange">
              {principle.number}
            </span>
            <h3 class="mt-5 text-2xl font-extrabold leading-tight text-kuroki-black">
              {principle.title}
            </h3>
            <p class="mt-3 text-sm leading-7 text-kuroki-gray">
              {principle.description}
            </p>
          </article>
        ))
      }
    </div>
  </Container>
</section>
